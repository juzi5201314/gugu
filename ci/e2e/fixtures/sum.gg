//! 根据实参个数计算三角数，写入标准输出后以指定状态退出。

use std.env as env
use std.io.{println}
use std.process as process

fn triangular(n: int) int {
    let total = 0
    for i in 0..n {
        total = total + i
    }
    return total
}

fn main() {
    let total = triangular(env.args().len() + 5)
    if total != 15 {
        panic("unexpected sum")
    }
    println("sum verified")
    process.exit(7)
}
