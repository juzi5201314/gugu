// ---
struct Cell[T] {}
fn read(value: Cell[Missing]) {}
fn main() {}

// ---
fn read(value: [int; -1]) {}
fn main() {}

// ---
struct Cell[comptime N: bool] {}
fn main() {}

// ---
fn read[T: Missing](value: T) {}
fn main() {}

// ---
trait Mark[T] {}
fn read[T: Mark](value: T) {}
fn main() {}

// ---
struct Cell[T] {}
fn read(value: Cell::Item) {}
