use std.runtime.{ownership_publish, root_publish}

fn main() {
    let keep = 1
    let first = fn() { _ = keep }
    let second = first
    let publish = fn() {
        let a = first
        let b = first
        ownership_publish(first, a)
        root_publish(second, b)
    }
    publish()
    _ = first
    _ = second
}
