/* LocalHeap 的 Immix arena side metadata、object header 与 pin side table 的 Gugu 定义；
 * 与 compiler runtime layout query 逐字段交叉校验。
 * 每项只保存 arena 序号、generation、bitmap 位置与计数，
 * 禁止出现 managed pointer、field 地址或栈指针。
 */

#[repr(C, align(8))]
pub struct ObjectHeader {
    pub control: uint,
    pub payload_size_or_forward: uint,
}

#[repr(C, align(8))]
pub struct HeapArenaMetadata {
    pub state: u32,
    pub generation: u32,
    pub mark_epoch: uint,
    pub alloc_cursor: u32,
    pub pin_count: u32,
    pub object_start: [uint; 2048],
    pub mark: [uint; 2048],
    pub page_cover: [u32; 512],
    pub cards: [byte; 4096],
    pub block_live: [u32; 64],
    pub line_live: [byte; 16384],
}

#[repr(C, align(8))]
pub struct HeapPinEntry {
    pub arena: u32,
    pub offset: u32,
    pub generation: u32,
    pub count: u32,
}

#[repr(C, align(64))]
pub struct HeapBlockRecord {
    pub block_id: u32,
    pub generation: u32,
    pub arena_descriptor: u32,
    pub block_index: u32,
    pub manager_owner: uint,
    pub incoming_leases: uint,
    pub mutation_version: uint,
    pub allocator_leases: u32,
    pub scanner_leases: u32,
    pub evacuation_leases: u32,
    pub candidate_job: u32,
    pub state: u32,
    pub reserved: u32,
}

/// 非空 package 必经布局交叉校验。
#[used]
pub fn heap_records(header: &ObjectHeader, arena: &HeapArenaMetadata, pin: &HeapPinEntry, block: &HeapBlockRecord) u32 {
    arena.state + arena.pin_count + pin.count + arena.generation + pin.arena + block.state + block.generation
}

/* SharedHeap 的稳定身份槽与 payload 记录；与 compiler runtime layout query 逐字段交叉校验。
 * 槽只保存 handle generation、状态、payload identity 与 lease 计数，payload 记录只保存逻辑
 * 身份与 block/offset；两者都禁止出现 managed pointer、field 地址或栈指针。
 */

#[repr(C, align(64))]
pub struct SharedHandleSlot {
    pub generation: u32,
    pub state: u32,
    pub current_payload: uint,
    pub old_payload: uint,
    pub forward_generation: u32,
    pub grace_epoch: u32,
    pub access_guards: u32,
    pub pin_leases: u32,
    pub mark_tickets: u32,
    pub forwarding_leases: u32,
    pub owner_id: u32,
    pub block_id: u32,
    pub payload_bytes: u32,
    pub reserved: u32,
}

#[repr(C, align(8))]
pub struct SharedPayloadRecord {
    pub payload_generation: u32,
    pub payload_slot: u32,
    pub block_id: u32,
    pub block_offset: u32,
    pub generation: u32,
    pub owner_id: u32,
    pub bytes: u32,
    pub state: u32,
}

/// 非空 package 必经布局交叉校验。
#[used]
pub fn shared_heap_records(slot: &SharedHandleSlot, payload: &SharedPayloadRecord) u32 {
    slot.state + slot.access_guards + slot.pin_leases + payload.state + payload.bytes + slot.owner_id + payload.generation
}
