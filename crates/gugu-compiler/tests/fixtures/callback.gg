#![allow(missing_docs)]
#[repr(C)]
struct Mixed { pub number: i64, pub fraction: f64 }
#[repr(C)]
struct Large { pub first: i64, pub second: i64, pub third: i64 }
pub extern "C" fn callback_add(a: i64, b: i64) i64 { a + b }
pub extern "C" fn callback_mixed(value: Mixed) Mixed { value }
pub extern "C" fn callback_large(value: Large) Large { value }
fn main() {}
