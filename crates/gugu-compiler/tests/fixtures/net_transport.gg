use std.net.{TcpStream, TcpListener, UdpSocket, SocketAddr, Ipv4Addr, IpAddr, BindOptions, DatagramBindOptions, ConnectOptions, Shutdown, KeepAliveConfig, InterfaceIndex, UnixAddr, UnixStream, UnixListener}
use std.io.{Read, Write, Bytes, Error}
use std.sync.{CancelSource}
use std.time.{Duration}
use std.path.{Path}
use std.collections.{Vec}
use std.net.{Ipv6Addr}
#[used]
fn candidates() Vec[SocketAddr] {
    let values = Vec[SocketAddr]::new()
    values.push(SocketAddr::new(IpAddr::V6(Ipv6Addr::new([0; 8])), 1))
    values.push(SocketAddr::new(IpAddr::V6(Ipv6Addr::new([0; 8])), 2))
    values.push(SocketAddr::new(IpAddr::V4(Ipv4Addr::new(127, 0, 0, 1)), 3))
    values.push(SocketAddr::new(IpAddr::V4(Ipv4Addr::new(127, 0, 0, 1)), 4))
    values
}
#[used]
fn candidate_port(values: Vec[SocketAddr], index: int) uint = match values.get(index) {
    Some(value) => uint(value.port()), None => uint(0),
}

fn numeric() SocketAddr = SocketAddr::new(IpAddr::V4(Ipv4Addr::new(127, 0, 0, 1)), 0)
#[used]
fn stream(stream: TcpStream) Result[(), Error] {
    let cancel = CancelSource::new().token()
    let data: [byte; 8] = [0; 8]
    let (read, write) = stream.split()
    _ = stream.read(&data)?
    _ = read.read_cancel(&data, &cancel)?
    _ = stream.write(Bytes::copy_from(&data))?
    _ = write.write_cancel(Bytes::new(), &cancel)?
    stream.set_read_timeout(Some(Duration::new(1, 2)))?
    _ = stream.read_timeout()?
    stream.set_write_timeout(None)?
    _ = stream.write_timeout()?
    stream.set_nodelay(true)?
    _ = stream.nodelay()?
    stream.set_keepalive(Some(KeepAliveConfig::new()))?
    _ = stream.keepalive()?
    stream.set_ttl(64)?
    _ = stream.ttl()?
    stream.set_recv_buffer_size(8192)?
    _ = stream.recv_buffer_size()?
    stream.set_send_buffer_size(8192)?
    _ = stream.send_buffer_size()?
    _ = stream.local_addr()?
    _ = stream.peer_addr()?
    stream.shutdown(Shutdown::Both)?
    read.shutdown()?
    write.shutdown()?
    stream.close()
}
#[used]
fn datagram(socket: UdpSocket) Result[(), Error] {
    let cancel = CancelSource::new().token()
    let data: [byte; 4] = [0; 4]
    _ = socket.recv_from_cancel(&data, &cancel)?
    _ = socket.recv_packet_cancel(8, &cancel)?
    socket.send_to(Bytes::new(), numeric())?
    socket.connect(numeric())?
    socket.send(Bytes::new())?
    _ = socket.recv_cancel(&data, &cancel)?
    _ = socket.peer_addr()?
    socket.disconnect()?
    socket.set_broadcast(true)?
    _ = socket.broadcast()?
    socket.set_multicast_loop(false)?
    _ = socket.multicast_loop()?
    socket.set_multicast_ttl(0)?
    _ = socket.multicast_ttl()?
    socket.join_multicast(IpAddr::V4(Ipv4Addr::new(239, 1, 2, 3)), Some(InterfaceIndex(0)))?
    socket.leave_multicast(IpAddr::V4(Ipv4Addr::new(239, 1, 2, 3)), None)?
    socket.close()
}
#[used]
fn unix_api() Result[(), Error] {
    let address = match UnixAddr::from_path(Path::from_string("/tmp/gugu-net-transport.sock")) { Ok(value) => value, Err(_) => return Err(Error::InvalidInput) }
    let listener = UnixListener::bind(address)?
    let task = async UnixStream::connect(address)
    let (stream, _) = listener.accept()?
    let data: [byte; 4] = [0; 4]
    _ = stream.read(&data)?
    _ = stream.write(Bytes::new())?
    _ = stream.split()
    stream.shutdown(Shutdown::Both)?
    _ = stream.local_addr()?
    _ = stream.peer_addr()?
    _ = task
    stream.close()?
    listener.close()
}
#[cfg(os = "linux")]
use std.net.{UnixDatagram}

#[cfg(os = "linux")]
#[used]
fn unix_datagram() Result[(), Error] {
    let address = match UnixAddr::from_path(Path::from_string("/tmp/gugu-net-datagram.sock")) { Ok(value) => value, Err(_) => return Err(Error::InvalidInput) }
    let socket = UnixDatagram::bind(address)?
    socket.send_to(Bytes::new(), address)?
    let data: [byte; 2] = [0; 2]
    _ = socket.recv_from(&data)?
    socket.close()
}
fn main() {
    _ = TcpStream::connect_with(numeric(), ConnectOptions::new())
    _ = UdpSocket::bind(numeric(), DatagramBindOptions::new())
    _ = TcpListener::bind(numeric(), BindOptions::new())
}
