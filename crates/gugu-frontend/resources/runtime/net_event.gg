use std.runtime.net_deadline as clock
use std.runtime.net_dispatch as services
use std.runtime.net_platform as native
use std.runtime.fs_platform.{control_allocate, control_free}
use std.runtime.heap.{heap_word, heap_store_word}
use std.runtime.scheduler.{park_current, ready_hot}

// 事件对象由 managed 根跟踪；计时链只保存 raw 节点和协程身份。
pub struct Event { pub sequence: uint, waiter: uint }
pub fn event() Event = Event { sequence: 0, waiter: 0 }
static first: uint = 0
static last: uint = 0
static cursor: uint = 0
pub fn pending() bool = first != 0
fn unlink(node: uint) {
    let next = heap_word(node)
    let previous = heap_word(node + 8)
    if previous == 0 { first = next } else { heap_store_word(previous, next) }
    if next == 0 { last = previous } else { heap_store_word(next + 8, previous) }
    if cursor == node { cursor = next }
}
fn complete(node: uint, status: uint) {
    if heap_word(node + 48) != 0 { return }
    heap_store_word(node + 48, 1)
    heap_store_word(node + 40, status)
    unlink(node)
    ready_hot(heap_word(node + 16))
}
pub fn notify(event: &Event) {
    event.sequence = event.sequence + 1
    if event.waiter != 0 { complete(event.waiter, 0) };
}
pub fn wait(event: &Event, sequence: uint, deadline: uint, cancel: uint) uint { unsafe {
    if event.sequence != sequence { return 0 }
    if native.cancelled(cancel) { return native.CANCELLED }
    if deadline != 0 && clock.expired(deadline, clock.now()) { return clock.TIMED_OUT }
    services.install_timer(service, pending)
    let node = control_allocate(64)
    defer { control_free(node, 64) }
    heap_store_word(node + 8, last)
    heap_store_word(node + 16, std.runtime.current_slot())
    heap_store_word(node + 24, deadline)
    heap_store_word(node + 32, cancel)
    if last == 0 { first = node } else { heap_store_word(last, node) }
    last = node
    event.waiter = node
    park_current()
    event.waiter = 0
    heap_word(node + 40)
} }
pub fn service() {
    let node = cursor
    if node == 0 { node = first }
    let budget: uint = 128
    while node != 0 && budget != 0 {
        let next = heap_word(node)
        let deadline = heap_word(node + 24)
        if native.cancelled(heap_word(node + 32)) { complete(node, native.CANCELLED) }
        else { if deadline != 0 && clock.expired(deadline, clock.now()) { complete(node, clock.TIMED_OUT) }; }
        node = next
        budget = budget - 1
    }
    cursor = node
}
