use std.runtime.barrier.{barrier_init}
use std.runtime.native_memory as mapping
use std.runtime.counters as counters
use std.runtime.compression as compression
use std.runtime.heap.{copy_bytes, heap_boot, value_size}
use std.runtime.trace.{trace_init}

/* 单 OS worker 上的 Classic64 本地队列。
 *
 * processor 页由 rt0 清零。128/256 是 head/tail，384 起是 256 个槽，3552 是 run_next，
 * 3560 是 edge staging 指针，3568 是 overflow carry，3576 是 barrier 状态页指针，
 * 3584 是栈扫描 epoch，3592 是 arena 基址，4032 是存活数，4048/4056 是堆游标，
 * 4072 是子协程入口，4080 是状态区。
 * 热记录的 +16 是 processor，+48 是 cold 地址。等待只改协程状态并切回系统栈。
 */

fn word(address: uint) uint {
    unsafe { std.ptr.read_unaligned[uint](std.mem.transmute[uint, *uint](address)) }
}

fn store_word(address: uint, value: uint) {
    unsafe { std.ptr.ptr_write[uint](std.mem.transmute[uint, *uint](address), value) }
}

fn fail() {
    unsafe { std.runtime.process_exit(2) }
}

/// 子协程参数包字节数：与 `coroutine_layout.rs` 的机器契约一致（Rust 侧镜像测试钉死）。
///
/// 入口片段、LIR 发包点、调度器复制点共用同一份偏移；原始分配按 64 字节对齐，满足包内 XMM
/// 车道 16 字节装载的要求。
pub const COROUTINE_PACK_BYTES: uint = 208

/// 参数包 lane map：与 `coroutine_layout.rs` 同一编码（3 位/车道，0 = 非根，n+1 = 根种类 n）。
pub const COROUTINE_PACK_LANES: uint = 17
pub const COROUTINE_PACK_TRACE_BITS: uint = 3
pub const COROUTINE_PACK_TRACE_NONE: uint = 0
/// 车道布局：9 个整数车道按 8 字节连续排布，其后 8 个浮点车道按 16 字节排布。
pub const COROUTINE_PACK_INTEGER_LANES: uint = 9
pub const COROUTINE_PACK_FLOAT_OFFSET: uint = 72
pub const COROUTINE_PACK_FLOAT_STRIDE: uint = 16

/// typed 动态根登记表：表头 + 固定容量记录。所有常量与 `dynamic_roots_schema.rs` 逐项一致。
///
/// 发布与结清都以稳定身份（热记录地址）为单位；表地址写在处理器槽 4064。`descriptor` 为 0
/// 只表示该类别尚未接线描述符，不表示「载荷无根」。
pub const DYNAMIC_ROOT_TABLE_HEADER_BYTES: uint = 16
pub const DYNAMIC_ROOT_RECORD_BYTES: uint = 48
pub const DYNAMIC_ROOT_CAPACITY: uint = 256
pub const DYNAMIC_ROOT_SLOT_OFFSET: uint = 8
pub const DYNAMIC_ROOT_DESCRIPTOR_OFFSET: uint = 16
pub const DYNAMIC_ROOT_COUNT_OFFSET: uint = 24
pub const DYNAMIC_ROOT_KIND_OFFSET: uint = 32
pub const DYNAMIC_ROOT_FLAGS_OFFSET: uint = 40
pub const DYNAMIC_ROOT_TABLE_COUNT_OFFSET: uint = 8
pub const DYNAMIC_ROOT_FLAG_INITIALIZED: uint = 1
pub const DYNAMIC_ROOT_KIND_SPAWN_PAYLOAD: uint = 0
pub const DYNAMIC_ROOT_KIND_RESULT: uint = 1
/// channel 环槽：载荷槽是环内那条槽本身，描述是元素类型的受管车道表地址。
pub const DYNAMIC_ROOT_KIND_CHANNEL_SLOT: uint = 2
/// 处理器页里动态根表地址的槽位；与 `PROCESSOR_DYNAMIC_ROOTS_OFFSET` 一致。
pub const PROCESSOR_DYNAMIC_ROOTS_OFFSET: uint = 4064
/// 冷记录的载荷发布状态字（与 Rust 侧 `CoroutineCold` 同偏移同语义）。
///
/// 载荷的生死互不重叠，因此一个状态字足够表达：位 0 = spawn 参数包已发布（入队前发布、结束时
/// 就地结清），位 1 = 结果载荷已发布（结束时发布、被 Join/select 取走时结清），位 3 起 3 位是
/// 结果根的栈图根种类判别值（0 = 结果字不含根，非 0 时结束时必须发布结果登记）。位必须按顺序
/// 推进：没有发布过结果的协程不允许结清结果，重复结清是不变量错误。
pub const COROUTINE_COLD_PAYLOAD_STATE_OFFSET: uint = 504
/// 位 0：spawn 参数包已发布，结束时必须结清。
pub const COROUTINE_COLD_SPAWN_PUBLISHED_BIT: uint = 1
/// 位 1：结果载荷已发布，被 Join 或 select 取走时必须结清。
pub const COROUTINE_COLD_RESULT_PUBLISHED_BIT: uint = 2
/// 结果根种类位段：位 3 起 3 位，lane map 编码（0 = 结果字不含根，n+1 = 栈图根种类判别值 n，
/// 即 Direct=1、Interior=2、Handle=3、Compressed=4、StackInterior=5）。
pub const COROUTINE_COLD_RESULT_KIND_SHIFT: uint = 3
pub const COROUTINE_COLD_RESULT_KIND_MASK: uint = 7
/// 冷记录里结果字槽的偏移；结束写、Join 取，`take_result` 是该字的唯读取入口。
pub const COROUTINE_COLD_COMPLETION_OFFSET: uint = 368
pub const COROUTINE_COLD_RESULT_OFFSET: uint = 376
pub const COROUTINE_COLD_JOIN_WAITER_OFFSET: uint = 512
/// 测试 harness 子树归属：组记录地址，spawn 时从当前协程冷记录继承；零表示无归属。
pub const COROUTINE_COLD_SUBTREE_GROUP_OFFSET: uint = 536
/// 完成结果为未交付 panic 时置位，取值记录「未处理」计数的归属：
/// `COROUTINE_COLD_PANIC_WAITED` 已登记等待者（不计数）、`COROUTINE_COLD_PANIC_GROUPED`
/// 计入子树组、`COROUTINE_COLD_PANIC_DETACHED` 计入 state+768。取走时清零并按归属减回。
pub const COROUTINE_COLD_PANIC_RESULT_OFFSET: uint = 544
pub const COROUTINE_COLD_PANIC_WAITED: uint = 1
pub const COROUTINE_COLD_PANIC_GROUPED: uint = 2
pub const COROUTINE_COLD_PANIC_DETACHED: uint = 3
pub const COROUTINE_COLD_BYTES: uint = 576
/// 结果区的字节数：子协程返回 ABI 只携带两个机器字，结果槽的上界就是它。
///
/// 超过该上界的载荷需要子侧装箱（结果字退化成指向带描述符载荷对象的引用），属显式迁移缺口；
/// `take_result` 遇到越界只按 fatal 处理，不静默截断。
pub const COROUTINE_COLD_RESULT_BYTES: uint = 16

fn proc_of(hot: uint) uint = word(hot + 16)

/// 动态根登记表首地址；处理器由调用方给出，不做「当前协程」猜测。
fn dynamic_root_table(processor: uint) uint = word(processor + PROCESSOR_DYNAMIC_ROOTS_OFFSET)

/// 第 index 条记录地址；越界返回 0。
fn dynamic_root_entry(table: uint, index: uint) uint {
    if index >= word(table) { return 0 }
    table + DYNAMIC_ROOT_TABLE_HEADER_BYTES + index * DYNAMIC_ROOT_RECORD_BYTES
}

/// 发布一条动态根：身份必须唯一、载荷槽必须非空、条数至少 1。
///
/// 表满与重复身份都是不变量错误：已发布的载荷绝不能被静默丢弃，调用方只能在复制完成后、入队
/// 或发布之前调用。
pub fn dynamic_root_publish(processor: uint, identity: uint, slot: uint, descriptor: uint, count: uint, kind: uint) {
    if identity == 0 || slot == 0 || count == 0 { fail() }
    unsafe {
        let table = dynamic_root_table(processor)
        let capacity = word(table)
        let free: uint = 0
        let index: uint = 0
        while index < capacity {
            let entry = dynamic_root_entry(table, index)
            if word(entry) == identity { fail() }
            if free == 0 && word(entry) == 0 { free = entry }
            index = index + 1
        }
        if free == 0 { fail() }
        store_word(free, identity)
        store_word(free + DYNAMIC_ROOT_SLOT_OFFSET, slot)
        store_word(free + DYNAMIC_ROOT_DESCRIPTOR_OFFSET, descriptor)
        store_word(free + DYNAMIC_ROOT_COUNT_OFFSET, count)
        store_word(free + DYNAMIC_ROOT_KIND_OFFSET, kind)
        store_word(free + DYNAMIC_ROOT_FLAGS_OFFSET, DYNAMIC_ROOT_FLAG_INITIALIZED)
        store_word(table + DYNAMIC_ROOT_TABLE_COUNT_OFFSET, word(table + DYNAMIC_ROOT_TABLE_COUNT_OFFSET) + 1)
    }
}

/// 结清一条动态根：身份必须存在，重复结清是不变量错误。
pub fn dynamic_root_retire(processor: uint, identity: uint) {
    if identity == 0 { fail() }
    unsafe {
        let table = dynamic_root_table(processor)
        let capacity = word(table)
        let index: uint = 0
        while index < capacity {
            let entry = dynamic_root_entry(table, index)
            if word(entry) == identity {
                let cleared: uint = 0
                while cleared < DYNAMIC_ROOT_RECORD_BYTES {
                    store_word(entry + cleared, 0)
                    cleared = cleared + 8
                }
                store_word(table + DYNAMIC_ROOT_TABLE_COUNT_OFFSET, word(table + DYNAMIC_ROOT_TABLE_COUNT_OFFSET) - 1)
                return
            }
            index = index + 1
        }
        fail()
    }
}

pub const PROCESSOR_COROUTINE_REGISTRY_OFFSET: uint = 4000
pub const PROCESSOR_RETIRED_STACKS_OFFSET: uint = 4008
pub const RETIRED_STACK_SERVICE_BUDGET: uint = 8

/// 只在系统栈调度入口调用；节点中的 hot 继续保留 Join 结果。
pub fn trim_retired_stacks(processor: uint) {
    if word(processor + mapping.RUNTIME_PRESSURE_STATE_OFFSET) == 0 { return }
    let remaining = RETIRED_STACK_SERVICE_BUDGET
    let budget = mapping.OWNER_DRAIN_BYTES
    while remaining != 0 && budget != 0 {
        let node = word(processor + PROCESSOR_RETIRED_STACKS_OFFSET)
        if node == 0 { return }
        let hot = word(node + 8)
        if word(hot) != 16 { fail() }
        let capacity = word(hot + 88)
        if capacity > budget {
            let low = word(hot + 80) - capacity
            if mapping.decommit_retired_stack(low, budget) != 0 { return }
            store_word(hot + 88, capacity - budget)
            store_word(hot + 72, low + budget)
            store_word(hot + 64, low + budget + 512)
            return
        }
        budget = budget - capacity
        let reserve: uint = 1073741824
        if mapping.release_retired_stack(word(hot + 80) - reserve, reserve, capacity) != 0 { return }
        store_word(hot + 64, 0)
        store_word(hot + 72, 0)
        store_word(hot + 80, 0)
        store_word(hot + 88, 0)
        store_word(processor + PROCESSOR_RETIRED_STACKS_OFFSET, word(node))
        let storage = word(word(hot + 48) + 528)
        if storage != 0 {
            counters.remove(counters.CALLBACK_CACHE, 4096)
            mapping.release_mapping(storage, 4096, 4096)
        }
        remaining = remaining - 1
    }
}


/// 控制区只使用前缀；整页尾部可在原 reservation 内撤销提交。
pub fn trim_control_cache(processor: uint) bool { unsafe {
    let cursor = word(processor + 4048)
    let end = word(processor + mapping.SCHEDULER_COMMITTED_END_OFFSET)
    let first = (cursor + 4095) / 4096 * 4096
    if end <= first { return true }
    let bytes = if end - first > mapping.OWNER_DRAIN_BYTES { mapping.OWNER_DRAIN_BYTES } else { end - first }
    let range = StackRange { base: end - bytes, bytes }
    if mapping.decommit(std.mem.transmute[*StackRange, uint](std.ptr.addr_of(range))) != 0 { return false }
    store_word(processor + mapping.SCHEDULER_COMMITTED_END_OFFSET, end - bytes)
    end - bytes == first
} }

fn register_coroutine(processor: uint, hot: uint) {
    let storage = word(word(hot + 48) + 528)
    let node = if storage != 0 { storage + 960 } else { heap_alloc(processor, 16) }
    store_word(node, word(processor + PROCESSOR_COROUTINE_REGISTRY_OFFSET))
    store_word(node + 8, hot)
    store_word(processor + PROCESSOR_COROUTINE_REGISTRY_OFFSET, node)
}

pub fn unregister_coroutine(processor: uint, hot: uint) uint {
    let link = processor + PROCESSOR_COROUTINE_REGISTRY_OFFSET
    let remaining = live_count(processor)
    while word(link) != 0 && remaining != 0 {
        let node = word(link)
        if word(node + 8) == hot {
            store_word(link, word(node))
            store_word(node, word(processor + PROCESSOR_RETIRED_STACKS_OFFSET))
            store_word(processor + PROCESSOR_RETIRED_STACKS_OFFSET, node)
            return node
        }
        link = node
        remaining = remaining - 1
    }
    fail()
    0
}

/// 当前已发布的动态根条数；收集器与探针从这里进入。
pub fn dynamic_root_count(processor: uint) uint = word(dynamic_root_table(processor) + DYNAMIC_ROOT_TABLE_COUNT_OFFSET)

/// 动态根表的固定容量（表首字）。
///
/// 表是**稀疏**的：发布填第一个空槽、结清把该槽清零，所以存活记录并不集中在 `0..count`。
/// 遍历方必须扫全表并按身份字跳过空槽，不能按 `0..count` 取下标。
pub fn dynamic_root_capacity(processor: uint) uint = word(dynamic_root_table(processor))

/// 第 index 条动态根记录地址；越界返回 0。字段偏移见同名前缀常量。
pub fn dynamic_root_record(processor: uint, index: uint) uint = dynamic_root_entry(dynamic_root_table(processor), index)

fn state_of(processor: uint) uint = word(processor + 4080)

pub fn heap_alloc(processor: uint, bytes: uint) uint {
    let cursor = word(processor + 4048)
    let aligned = cursor / 64 * 64
    let start = if aligned == cursor { cursor } else { aligned + 64 }
    if start + bytes > word(processor + 4056) { fail() }
    let end = word(processor + mapping.SCHEDULER_COMMITTED_END_OFFSET)
    if start + bytes > end {
        let needed = (start + bytes + 4095) / 4096 * 4096
        commit_stack(end, needed - end)
        store_word(processor + mapping.SCHEDULER_COMMITTED_END_OFFSET, needed)
        mapping.pressure_dirty(processor, 2)
    }
    store_word(processor + 4048, start + bytes)
    start
}

fn commit_stack(base: uint, bytes: uint) {
    unsafe {
        let range = StackRange { base: base, bytes: bytes }
        if mapping.commit(std.mem.transmute[*StackRange, uint](std.ptr.addr_of(range))) != 0 { fail() }
    }
}

#[repr(C)]
struct StackRange { base: uint, bytes: uint }

fn zero_range(processor: uint, start: uint, end: uint) {
    let index = start
    while index < end {
        store_word(processor + index, 0)
        index = index + 8
    }
}

fn map_span(bytes: uint) uint {
    unsafe {
        let base = mapping.reserve_aligned(bytes, uint(4096))
        if base == 0 { fail() }
        commit_stack(base, bytes)
        base
    }
}

/// 清零队列，保留并初始化 TLAB/TurnRegion。main 槽算作第一个存活协程。
///
/// 3520..3552 是编译器 bump 的 cursor/limit。清成 0 会让快路径把对象头写到空地址。
pub fn boot(processor: uint, state: uint, slot: uint, cold: uint, enter: uint) {
    unsafe {
        zero_range(processor, 64, 3520)
        zero_range(processor, 3552, 4096)
        store_word(slot + 16, processor)
        mapping.adopt_boot(processor, uint(1073741824), uint(65536), word(word(state + 760) + 8))
        let heap = map_span(1048576)
        // TLAB 不再是裸映射：由分配器建立真实 arena 并把 cursor/limit 指向首块的可分配范围。
        // TurnRegion 也不再是裸映射：cursor/limit 留 0，首次区域分配由 `gc_region_slow` 建立
        // 真实区域（容量取自配置的块字节数），快路径在 limit==0 时必然走慢路，不会写到空地址。
        compression.cage_boot()
        heap_boot(processor)
        barrier_init(processor)
        trace_init(processor)
        store_word(processor + 3536, 0)
        store_word(processor + 3544, 0)
        store_word(processor + 4032, 1)
        store_word(processor + 4048, heap)
        store_word(processor + 4056, heap + 1048576)
        store_word(processor + mapping.SCHEDULER_COMMITTED_END_OFFSET, heap + 1048576)
        // 系统服务运行在启动线程原栈，由 OS 栈守卫约束；零检查界与 rt0 初始槽一致。
        let system_slot = heap_alloc(processor, 128)
        store_word(system_slot + 16, processor)
        store_word(processor + 4088, system_slot)
        let roots = heap_alloc(processor, DYNAMIC_ROOT_TABLE_HEADER_BYTES + DYNAMIC_ROOT_CAPACITY * DYNAMIC_ROOT_RECORD_BYTES)
        store_word(roots, DYNAMIC_ROOT_CAPACITY)
        store_word(roots + DYNAMIC_ROOT_TABLE_COUNT_OFFSET, 0)
        store_word(processor + PROCESSOR_DYNAMIC_ROOTS_OFFSET, roots)
        store_word(processor + 4072, enter)
        store_word(processor + 4080, state)
        store_word(slot + 16, processor)
        store_word(slot + 48, cold)
        store_word(slot, 1)
        register_coroutine(processor, slot)
    }
}

fn enqueue(processor: uint, hot: uint) {
    let head = word(processor + 128)
    let tail = word(processor + 256)
    if tail - head >= 256 { overflow(processor) }
    let tail = word(processor + 256)
    store_word(processor + 384 + (tail % 256) * 8, hot)
    store_word(processor + 256, tail + 1)
}

fn overflow(processor: uint) {
    let moved: uint = 0
    while moved < 128 && word(processor + 256) != word(processor + 128) {
        let head = word(processor + 128)
        let hot = word(processor + 384 + (head % 256) * 8)
        store_word(processor + 128, head + 1)
        store_word(hot + 8, word(processor + 3568))
        store_word(processor + 3568, hot)
        moved = moved + 1
    }
}

/// 先取 run_next，再取本地头（yield 放在尾部，已有 runnable 先被选中），最后取 overflow carry。
pub fn take_next(processor: uint) uint {
    let next = word(processor + 3552)
    if next != 0 {
        store_word(processor + 3552, 0)
        return next
    }
    let head = word(processor + 128)
    let tail = word(processor + 256)
    if tail != head {
        let hot = word(processor + 384 + (head % 256) * 8)
        store_word(processor + 128, head + 1)
        return hot
    }
    let carry = word(processor + 3568)
    if carry == 0 { return 0 }
    store_word(processor + 3568, word(carry + 8))
    carry
}

pub fn ready_hot(hot: uint) {
    let processor = proc_of(hot)
    store_word(hot, 6)
    let current = word(processor + 3552)
    if current == 0 {
        store_word(processor + 3552, hot)
    } else {
        enqueue(processor, current)
        store_word(processor + 3552, hot)
    }
}

fn switch_out(hot: uint) {
    unsafe {
        let processor = proc_of(hot)
        let state = state_of(processor)
        let cold = word(hot + 48)
        std.runtime.context_switch(
            std.mem.transmute[uint, *()](cold + 8),
            std.mem.transmute[uint, *()](state + 40),
            std.mem.transmute[uint, *()](word(processor + 4088)),
            std.mem.transmute[uint, *()](processor),
        )
    }
}

/// 显式让出：放到本地尾，不占用 run_next。
#[used]
pub fn yield_now() {
    unsafe {
        let hot = std.runtime.current_slot()
        let processor = proc_of(hot)
        store_word(hot, 6)
        enqueue(processor, hot)
        store_word(state_of(processor) + 752, 1)
        switch_out(hot)
    }
}

pub fn park_current() {
    unsafe {
        let hot = std.runtime.current_slot()
        store_word(hot, 8)
        store_word(state_of(proc_of(hot)) + 752, 1)
        switch_out(hot)
    }
}

/// 回调没有用户 Join 句柄；退役且已结清根后可复用整页控制记录和原栈。
fn reuse_callback(processor: uint) uint {
    let link = processor + PROCESSOR_RETIRED_STACKS_OFFSET
    let remaining = RETIRED_STACK_SERVICE_BUDGET
    while word(link) != 0 && remaining != 0 {
        let node = word(link)
        let hot = word(node + 8)
        if word(word(hot + 48) + 528) != 0 {
            store_word(link, word(node))
            counters.remove(counters.CALLBACK_CACHE, 4096)
            return hot
        }
        link = node
        remaining = remaining - 1
    }
    0
}

fn prepare_child(processor: uint, code: uint, env: uint, trace: uint, result_kind: uint, callback: bool) uint {
    unsafe {
        let reserve: uint = 1073741824
        let reused = if callback { reuse_callback(processor) } else { uint(0) }
        let storage = if callback { if reused != 0 { reused } else { map_span(4096) } } else { uint(0) }
        let capacity = if reused != 0 { word(reused + 88) } else { uint(65536) }
        let stack_high: uint = 0
        if reused != 0 {
            stack_high = word(reused + 80)
            store_word(processor + mapping.STACK_LIVE_OFFSET, word(processor + mapping.STACK_LIVE_OFFSET) + capacity)
        } else {
            let stack_base = mapping.reserve_stack(reserve)
            if stack_base == 0 { fail() }
            stack_high = stack_base + reserve
            let extent = StackRange { base: stack_high - capacity, bytes: capacity }
            if mapping.commit_stack(std.mem.transmute[*StackRange, uint](std.ptr.addr_of(extent))) != 0 { fail() };
        }
        let slot = if callback { storage } else { heap_alloc(processor, 128) }
        let cold = if callback { storage + 128 } else { heap_alloc(processor, COROUTINE_COLD_BYTES) }
        let index: uint = 0
        while index < COROUTINE_COLD_BYTES {
            store_word(cold + index, 0)
            index = index + 8
        }
        // 参数包必须复制到子协程自持的原始内存并在入队前完成：父帧在 spawn 返回后即可被复用，
        // 子协程稍后运行时再读父帧就是悬垂读（复制源与目标在交接期间都可定位）。
        store_word(cold + 528, storage)
        let pack = if callback { storage + 704 } else { heap_alloc(processor, COROUTINE_PACK_BYTES) }
        let copied: uint = 0
        while copied < COROUTINE_PACK_BYTES {
            store_word(pack + copied, word(env + copied))
            copied = copied + 8
        }
        // 复制完成后、入队之前登记：子协程自持的包是它全部入参的唯一真相。
        // spawn 参数包的 trace 描述就是 lane map：3 位一个车道，0 非根，n+1 是根种类 n。
        dynamic_root_publish(processor, slot, pack, trace, COROUTINE_PACK_LANES, DYNAMIC_ROOT_KIND_SPAWN_PAYLOAD)
        let payload_state = COROUTINE_COLD_SPAWN_PUBLISHED_BIT | (result_kind << COROUTINE_COLD_RESULT_KIND_SHIFT)
        store_word(cold + COROUTINE_COLD_PAYLOAD_STATE_OFFSET, payload_state)
        store_word(slot + 16, processor)
        store_word(slot + 48, cold)
        store_word(slot + 64, stack_high - capacity + 512)
        store_word(slot + 72, stack_high - capacity)
        store_word(slot + 80, stack_high)
        store_word(slot + 88, capacity)
        let stack_top = stack_high / 16 * 16
        let frame = stack_top - 16
        store_word(frame, code)
        store_word(frame + 8, pack)
        store_word(cold + 8, frame)
        store_word(cold + 16, word(processor + 4072))
        store_word(slot, 6)
        register_coroutine(processor, slot)
        slot
    }
}

/// 创建子协程并放入本地尾。句柄是热记录地址。
#[used]
pub fn spawn(code: *(), env: *(), trace: uint, result_kind: uint) uint {
    unsafe {
        let parent = std.runtime.current_slot()
        let processor = proc_of(parent)
        let child = prepare_child(processor, std.mem.transmute[*(), uint](code), std.mem.transmute[*(), uint](env), trace, result_kind, false)
        // 子树归属在子协程运行前继承：测试 runner 用 group 挂接标记归属，detach 的普通
        // 协程 group 为零、不产生任何记账。
        let group = word(word(parent + 48) + COROUTINE_COLD_SUBTREE_GROUP_OFFSET)
        if group != 0 {
            store_word(word(child + 48) + COROUTINE_COLD_SUBTREE_GROUP_OFFSET, group)
            store_word(group, word(group) + 1)
        }
        store_word(processor + 4032, word(processor + 4032) + 1)
        enqueue(processor, child)
        child
    }
}

/// 外部线程的队列节点保持存活至完成确认；参数包不含 managed 引用。
pub fn callback_service(processor: uint) { unsafe {
    let control = std.runtime.callback_control()
    let node = std.runtime.callback_queue(control, 0, 2)
    if node == 0 || node == 3 { return }
    if node < 16 { fail() }
    let child = prepare_child(processor, word(node + 16), node + 32, 0, 0, true)
    store_word(word(child + 48) + 520, node)
    store_word(processor + 4032, word(processor + 4032) + 1)
    ready_hot(child)
} }

/// 控制操作只在机器锁外重试；外部线程仍需 detach 后才结清登记。
pub fn callback_gate(action: uint) { unsafe {
    let processor = word(std.runtime.current_slot() + 16)
    if action == 0 { store_word(std.runtime.callback_control() + 72, std.runtime.thread_id()) }
    let status = std.runtime.callback_queue(std.runtime.callback_control(), processor, action)
    while status == 3 { status = std.runtime.callback_queue(std.runtime.callback_control(), processor, action) }
    if status != 0 { fail() }
} }

/// safepoint_slow 尾跳此入口，父帧仍是精确 PollResume。
pub fn callback_poll() { unsafe {
    let processor = word(std.runtime.current_slot() + 16)
    let _ = std.runtime.atomic_fetch_and_acq_rel[u32](std.mem.transmute[uint, *u32](processor), ~u32(4))
    mapping.pressure_poll(processor)
    yield_now()
} }

pub fn callback_pending() bool { unsafe {
    std.runtime.atomic_load_acquire[uint](std.mem.transmute[uint, *uint](std.runtime.callback_control() + 32)) != 0
} }

fn callback_finish(cold: uint) { unsafe {
    let node = word(cold + 520)
    if node == 0 { return }
    store_word(cold + 520, 0)
    store_word(node + 16, 0)
    callback_complete(node)
} }

/// 只有 managed 回调和借用请求均已结束，才撤销活动登记并 release 发布完成。
pub fn callback_complete(node: uint) { unsafe {
    let state = std.runtime.atomic_load_acquire[uint](std.mem.transmute[uint, *uint](node + 8))
    if state != 2 || word(node + 16) != 0 { return }
    let control = std.runtime.callback_control()
    let status = std.runtime.callback_queue(control, node, 3)
    while status == 3 { status = std.runtime.callback_queue(control, node, 3) }
    if status != 0 { fail() }
} }

/// 协程返回：结清自己的动态根登记、发布结果、唤醒 Join，并减少存活数。
pub fn finish_hot(hot: uint, value: uint, second: uint) {
    let cold = word(hot + 48)
    let processor = proc_of(hot)
    // 归属组的 pending 记账只数存活，不管结果成败；panic 记账见 `panic_unwind` 与 `take_result`。
    let group = word(cold + COROUTINE_COLD_SUBTREE_GROUP_OFFSET)
    if group != 0 { store_word(group, word(group) - 1) }
    let state = word(cold + COROUTINE_COLD_PAYLOAD_STATE_OFFSET)
    if state & COROUTINE_COLD_SPAWN_PUBLISHED_BIT != 0 {
        dynamic_root_retire(processor, hot)
    }
    // 受管结果字在 Join 取走之前只存在于冷记录里，必须按编译期给出的根种类登记：lane map 的
    // 车道 0 指向结果槽本身，载荷对象由自带描述符描述。标量结果不登记。
    let kind = (state >> COROUTINE_COLD_RESULT_KIND_SHIFT) & COROUTINE_COLD_RESULT_KIND_MASK
    if kind != 0 {
        dynamic_root_publish(processor, hot, cold + COROUTINE_COLD_RESULT_OFFSET, kind, 1, DYNAMIC_ROOT_KIND_RESULT)
        store_word(cold + COROUTINE_COLD_PAYLOAD_STATE_OFFSET, (state & COROUTINE_COLD_SPAWN_PUBLISHED_BIT) | kind << COROUTINE_COLD_RESULT_KIND_SHIFT | COROUTINE_COLD_RESULT_PUBLISHED_BIT)
    } else {
        store_word(cold + COROUTINE_COLD_PAYLOAD_STATE_OFFSET, state & COROUTINE_COLD_SPAWN_PUBLISHED_BIT)
    }
    store_word(cold + COROUTINE_COLD_RESULT_OFFSET, value)
    store_word(cold + COROUTINE_COLD_RESULT_OFFSET + 8, second)
    store_word(cold + COROUTINE_COLD_COMPLETION_OFFSET, 1)
    let joiner = word(cold + COROUTINE_COLD_JOIN_WAITER_OFFSET)
    if joiner != 0 { ready_hot(joiner) }
    store_word(hot, 16)
    let _ = unregister_coroutine(processor, hot)
    mapping.retire_stack(processor, word(hot + 88))
    if word(cold + 528) != 0 { counters.add(counters.CALLBACK_CACHE, 4096) }
    let live = word(processor + 4032)
    if live != 0 { store_word(processor + 4032, live - 1) }
    callback_finish(cold)
}

/// 取走一个已结束协程的结果：先结清结果载荷登记，再把结果值复制进 `dst`（0 表示丢弃）。
///
/// 结果按元素描述符（`TypeRecord`，首字是 payload size）整份复制，而不是只搬一个机器字：两字
/// 载荷（例如带捕获的闭包）必须两字都送达，否则调用侧读到的是未初始化车道。标量结果从不发布
/// 载荷，因此取走时无事可做；发布过的结果只结清一次，位在结清时清零。
pub fn take_result(hot: uint, dst: uint, descriptor: uint) {
    let cold = word(hot + 48)
    let state = word(cold + COROUTINE_COLD_PAYLOAD_STATE_OFFSET)
    if state & COROUTINE_COLD_RESULT_PUBLISHED_BIT != 0 {
        dynamic_root_retire(proc_of(hot), hot)
        store_word(cold + COROUTINE_COLD_PAYLOAD_STATE_OFFSET, state & ~COROUTINE_COLD_RESULT_PUBLISHED_BIT)
    }
    // panic 完成记录不按 T 载荷复制：RESULT+0 是 Panic 句柄，取走即「已处理」。
    // panic_result 记录发布时计入了哪个未处理计数，这里按同一归属减回；
    // 已登记等待者的 panic 没有计数，不动任何账目。句柄本体由 `join_panic` 读取。
    let panic_kind = word(cold + COROUTINE_COLD_PANIC_RESULT_OFFSET)
    if panic_kind != 0 {
        store_word(cold + COROUTINE_COLD_PANIC_RESULT_OFFSET, 0)
        if panic_kind == COROUTINE_COLD_PANIC_GROUPED {
            let group = word(cold + COROUTINE_COLD_SUBTREE_GROUP_OFFSET)
            if group != 0 { store_word(group + 8, word(group + 8) - 1) }
            ()
        }
        if panic_kind == COROUTINE_COLD_PANIC_DETACHED {
            let runtime_state = word(proc_of(hot) + 4080)
            store_word(runtime_state + 768, word(runtime_state + 768) - 1)
        }
        return
    }
    if dst == 0 { return }
    let bytes = value_size(descriptor)
    if bytes > COROUTINE_COLD_RESULT_BYTES { fail() }
    copy_bytes(dst, cold + COROUTINE_COLD_RESULT_OFFSET, bytes)
}

/// 测试 harness 子树记账：组记录两车道 {pending, panics}，分配在当前处理器堆游标上。
///
/// runner 对每个测试建一条组记录，spawn 前挂接、spawn 后清回；组内协程结束时 pending--,
/// 未交付 panic 发布时 panics++、被取走时 panics--。组记录不回收，随堆区释放。
pub fn subtree_group_new() uint {
    unsafe {
        let group = heap_alloc(proc_of(std.runtime.current_slot()), 16)
        store_word(group, 0)
        store_word(group + 8, 0)
        group
    }
}

/// 把当前协程挂接/脱离子树组；runner 在 spawn 前设置、spawn 后立即清回 0。
pub fn subtree_group_attach(group: uint) {
    unsafe {
        store_word(word(std.runtime.current_slot() + 48) + COROUTINE_COLD_SUBTREE_GROUP_OFFSET, group)
    }
}

pub fn subtree_group_pending(group: uint) uint = word(group)
pub fn subtree_group_panics(group: uint) uint = word(group + 8)

pub fn live_count(processor: uint) uint = word(processor + 4032)

/// 恢复一个已就绪协程。没有可运行协程时返回 0。
pub fn resume_ready(state: uint) uint {
    unsafe {
        let processor = word(state + 96)
        let hot = take_next(processor)
        if hot == 0 { return 0 }
        store_word(hot, 1)
        store_word(state, hot)
        store_word(state + 32, word(hot + 48))
        store_word(state + 96, processor)
        std.runtime.context_restore(
            std.mem.transmute[uint, *()](word(hot + 48) + 8),
            std.mem.transmute[uint, *()](hot),
            std.mem.transmute[uint, *()](processor),
        )
        1
    }
}
