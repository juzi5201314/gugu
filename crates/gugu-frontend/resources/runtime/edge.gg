/* edge staging 的 owner/sequence/generation 门禁。相同序号只消费一次，
 * 过期周期、乱序序列与容量溢出都保留为可观测状态，不静默丢边。
 */

use std.runtime.counters as counters
use std.runtime.native_memory as mapping
use std.runtime.heap.{heap_fail, heap_store_word, heap_word}

pub const EDGE_STATE_BYTES: uint = 4096
pub const EDGE_CAPACITY: uint = 64
pub const EDGE_RECORD_BYTES: uint = 32
pub const EDGE_COUNT_OFFSET: uint = 0
pub const EDGE_OVERFLOW_OFFSET: uint = 8
pub const EDGE_CYCLE_OFFSET: uint = 16
pub const EDGE_NEXT_SEQUENCE_OFFSET: uint = 24
pub const EDGE_RECORDS_OFFSET: uint = 64

#[repr(C)]
struct EdgeExtent { base: uint, bytes: uint }

fn edge_zero(base: uint) {
    let at = base
    while at < base + EDGE_STATE_BYTES {
        heap_store_word(at, 0)
        at = at + 8
    }
}

pub fn edge_new(cycle: uint) uint {
    let base = unsafe { mapping.reserve_aligned(EDGE_STATE_BYTES, mapping.os_page_bytes()) }
    if base == 0 { heap_fail() }
    let extent = EdgeExtent { base: base, bytes: EDGE_STATE_BYTES }
    if unsafe { mapping.commit(std.mem.transmute[*EdgeExtent, uint](std.ptr.addr_of(extent))) } != 0 {
        heap_fail()
    }
    edge_zero(base)
    heap_store_word(base + EDGE_CYCLE_OFFSET, cycle)
    base
}

pub fn edge_append(state: uint, source: uint, target: uint, sequence: uint, delta: int) uint {
    if state == 0 { return 1 }
    if sequence != heap_word(state + EDGE_NEXT_SEQUENCE_OFFSET) { return 2 }
    let count = heap_word(state + EDGE_COUNT_OFFSET)
    if count >= EDGE_CAPACITY {
        heap_store_word(state + EDGE_OVERFLOW_OFFSET, 1)
        return 3
    }
    let record = state + EDGE_RECORDS_OFFSET + count * EDGE_RECORD_BYTES
    heap_store_word(record, source)
    heap_store_word(record + 8, target)
    heap_store_word(record + 16, sequence)
    heap_store_word(record + 24, uint(delta))
    heap_store_word(state + EDGE_COUNT_OFFSET, count + 1)
    heap_store_word(state + EDGE_NEXT_SEQUENCE_OFFSET, sequence + 1)
    counters.add(counters.EDGE_BATCHES, 1)
    0
}

pub fn edge_consume(state: uint, sequence: uint) uint {
    if state == 0 || sequence >= heap_word(state + EDGE_COUNT_OFFSET) { return 1 }
    let record = state + EDGE_RECORDS_OFFSET + sequence * EDGE_RECORD_BYTES
    if heap_word(record + 16) != sequence { return 2 }
    heap_store_word(record + 16, uint(4294967295))
    0
}

pub fn edge_pending(state: uint) uint = heap_word(state + EDGE_COUNT_OFFSET)
pub fn edge_overflow(state: uint) uint = heap_word(state + EDGE_OVERFLOW_OFFSET)
