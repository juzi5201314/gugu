use std.runtime.heap.{copy_bytes, value_size}
use std.runtime.scheduler.{dynamic_root_publish, dynamic_root_retire, park_current, ready_hot, take_result, COROUTINE_COLD_COMPLETION_OFFSET, COROUTINE_COLD_JOIN_WAITER_OFFSET, COROUTINE_COLD_PANIC_RESULT_OFFSET, COROUTINE_COLD_RESULT_OFFSET, DYNAMIC_ROOT_KIND_CHANNEL_SLOT}

/* 等待源控制块的 Gugu 定义；与 compiler runtime layout query 逐字段交叉校验。
 * wait-node 只保存协程句柄、generation、case 和下标偏移，禁止裸栈指针。
 * CoroutineCold.select_scratch 的 4 个 uint 解释为 SelectTxn 描述符；8-word 内联
 * scratch 是 processor-local cache 的 0 号 class。
 */

#[repr(C)]
pub struct SelectTxn {
    pub phase_winner: uint,
    pub case_count: uint,
    pub scratch_handle: uint,
    pub wait_block: uint,
}

#[repr(C, align(64))]
pub struct SelectScratchCache {
    pub inline_words: [uint; 8],
}

#[repr(C, align(64))]
pub struct WaitNode {
    pub coroutine_index: uint,
    pub coroutine_generation: uint,
    pub wait_generation: uint,
    pub case_index: uint,
    pub payload_offset: uint,
    pub result_offset: uint,
    pub next: uint,
    pub flags: uint,
}

#[repr(C, align(64))]
pub struct ChannelControl {
    pub source_id: uint,
    pub generation: uint,
    pub capacity: uint,
    pub closed: uint,
    pub head: uint,
    pub tail: uint,
    pub len: uint,
    pub send_q_head: uint,
    pub recv_q_head: uint,
    pub reservation_generation: uint,
    pub ring_index: uint,
    pub ring_generation: uint,
    /// 创建该通道的处理器：环载荷作为动态根登记在该处理器的表里。
    pub owner_processor: uint,
    /// 元素类型的受管车道表地址；0 表示元素不含根。
    pub element_roots: uint,
    pub padding: [byte; 16],
}

/// 非空 package 必经布局交叉校验。
#[used]
pub fn wait_records(control: &ChannelControl, node: &WaitNode, txn: &SelectTxn, cache: &SelectScratchCache) uint {
    control.owner_processor + control.element_roots + control.source_id + node.wait_generation + txn.case_count + cache.inline_words[0]
}

fn word(address: uint) uint {
    unsafe { std.ptr.read_unaligned[uint](std.mem.transmute[uint, *uint](address)) }
}

fn store_word(address: uint, value: uint) {
    unsafe { std.ptr.ptr_write[uint](std.mem.transmute[uint, *uint](address), value) }
}

fn byte_store(address: uint, value: byte) {
    unsafe { std.ptr.ptr_write[byte](std.mem.transmute[uint, *byte](address), value) }
}

fn current_hot() uint {
    unsafe { std.runtime.current_slot() }
}

fn as_uint(value: *()) uint {
    unsafe { std.mem.transmute[*(), uint](value) }
}

fn as_ptr(value: uint) *() {
    unsafe { std.mem.transmute[uint, *()](value) }
}

fn die() {
    unsafe { std.runtime.process_exit(2) }
}

fn proc_of(hot: uint) uint = word(hot + 16)

fn heap_alloc(processor: uint, bytes: uint) uint {
    let cursor = word(processor + 4048)
    let aligned = cursor / 64 * 64
    let start = if aligned == cursor { cursor } else { aligned + 64 }
    store_word(processor + 4048, start + bytes)
    start
}

fn alloc_node(processor: uint, hot: uint, payload: uint, result: uint, case: uint) uint {
    let node = heap_alloc(processor, 64)
    store_word(node, hot)
    store_word(node + 8, 1)
    store_word(node + 16, 1)
    store_word(node + 24, case)
    store_word(node + 32, payload)
    store_word(node + 40, result)
    store_word(node + 48, 0)
    store_word(node + 56, 0)
    node
}

fn push_queue(head: uint, node: uint) {
    if word(head) == 0 {
        store_word(head, node)
        return
    }
    let cursor = word(head)
    while word(cursor + 48) != 0 { cursor = word(cursor + 48) }
    store_word(cursor + 48, node)
}

fn pop_queue(head: uint) uint {
    let node = word(head)
    if node == 0 { return 0 }
    store_word(head, word(node + 48))
    node
}

fn wake_node(node: uint) {
    if node == 0 { return }
    let hot = word(node)
    store_word(hot + 40, word(node + 24))
    ready_hot(hot)
}

/// 容量与元素描述符决定环。句柄是控制块地址。
#[used]
pub fn channel_new(capacity: int, desc: *()) uint {
    unsafe {
        let processor = proc_of(current_hot())
        if capacity < 0 { panic("channel capacity must not be negative") }
        let control = heap_alloc(processor, 128)
        let index: uint = 0
        while index < 128 {
            store_word(control + index, 0)
            index = index + 8
        }
        let size = value_size(as_uint(desc))
        store_word(control + 16, uint(capacity))
        store_word(control + 72, size)
        store_word(control + 96, processor)
        if capacity > 0 && size != 0 {
            store_word(control + 80, heap_alloc(processor, uint(capacity) * size))
        }
        control
    }
}

#[used]
pub fn channel_close(handle: uint) {
    if word(handle + 24) != 0 { panic("close on closed channel") }
    store_word(handle + 24, 1)
    wake_node(pop_queue(handle + 56))
    wake_node(pop_queue(handle + 64))
}

fn deliver(control: uint, src: uint, dst: uint) {
    copy_bytes(dst, src, word(control + 72))
}

fn try_rendezvous_send(control: uint, payload: uint) byte {
    let node = pop_queue(control + 64)
    if node == 0 { return 0 }
    deliver(control, payload, word(node + 40))
    wake_node(node)
    1
}

/// 环载荷登记：把元素类型的受管车道表记进控制块并登记这条环槽。
///
/// 元素类型不含根时表为 0，不做任何登记；表只能有一个来源，后续 send 给出不同表即契约不一致。
fn register_ring_slot(control: uint, slot: uint, desc: uint) {
    if desc == 0 { return }
    let known = word(control + 104)
    if known != 0 && known != desc { die() }
    store_word(control + 104, desc)
    let count = unsafe { std.ptr.read_unaligned[uint](std.mem.transmute[uint, *uint](desc)) }
    dynamic_root_publish(word(control + 96), slot, slot, desc, count, DYNAMIC_ROOT_KIND_CHANNEL_SLOT)
}

/// 环槽出队：载荷已经复制走或即将复制走，登记必须同步结清。
fn retire_ring_slot(control: uint, slot: uint) {
    if word(control + 104) == 0 { return }
    dynamic_root_retire(word(control + 96), slot)
}

fn enqueue_value(control: uint, payload: uint, desc: uint) byte {
    let capacity = word(control + 16)
    let len = word(control + 48)
    if len >= capacity { return 0 }
    let size = word(control + 72)
    let tail = word(control + 40)
    if size != 0 {
        let slot = word(control + 80) + (tail % capacity) * size
        copy_bytes(slot, payload, size)
        register_ring_slot(control, slot, desc)
    }
    store_word(control + 40, tail + 1)
    store_word(control + 48, len + 1)
    wake_node(pop_queue(control + 64))
    1
}

fn park_on(control: uint, queue: uint, payload: uint, result: uint) {
    let hot = current_hot()
    let node = alloc_node(proc_of(hot), hot, payload, result, 0)
    push_queue(queue, node)
    park_current()
}

#[used]
pub fn channel_send(handle: uint, payload: *(), desc: *()) byte {
    let src = as_uint(payload)
    let roots = as_uint(desc)
    if word(handle + 24) != 0 { return 0 }
    if word(handle + 16) == 0 {
        if try_rendezvous_send(handle, src) == 1 { return 1 }
        park_on(handle, handle + 56, src, 0)
        return 1
    }
    while enqueue_value(handle, src, roots) == 0 {
        if word(handle + 24) != 0 { return 0 }
        park_on(handle, handle + 56, src, 0)
        if word(handle + 24) != 0 { return 0 };
    }
    1
}

fn dequeue_value(control: uint, dst: uint) byte {
    if word(control + 48) == 0 { return 0 }
    let size = word(control + 72)
    let head = word(control + 32)
    let capacity = word(control + 16)
    if size != 0 {
        let slot = word(control + 80) + (head % capacity) * size
        if dst != 0 { copy_bytes(dst, slot, size) }
        retire_ring_slot(control, slot)
    }
    store_word(control + 32, head + 1)
    store_word(control + 48, word(control + 48) - 1)
    wake_node(pop_queue(control + 56))
    1
}

fn recv_closed(dst: uint) {
    if dst != 0 { byte_store(dst, 1) }
}

#[used]
pub fn channel_receive(handle: uint, payload: *(), desc: *()) byte {
    _ = desc
    let dst = as_uint(payload)
    if word(handle + 16) == 0 {
        let node = pop_queue(handle + 56)
        if node != 0 {
            deliver(handle, word(node + 32), dst)
            wake_node(node)
            return 1
        }
        if word(handle + 24) != 0 { return 0 }
        park_on(handle, handle + 64, 0, dst)
        return 1
    }
    while dequeue_value(handle, dst) == 0 {
        if word(handle + 24) != 0 { return 0 }
        park_on(handle, handle + 64, 0, dst)
    }
    1
}

#[used]
pub fn channel_try_send(handle: uint, payload: *(), desc: *()) byte {
    if word(handle + 24) != 0 { return 2 }
    let src = as_uint(payload)
    if word(handle + 16) == 0 {
        if try_rendezvous_send(handle, src) == 1 { return 1 }
        return 0
    }
    if enqueue_value(handle, src, as_uint(desc)) == 1 { return 1 }
    0
}

#[used]
pub fn channel_try_recv(handle: uint, payload: *(), desc: *()) byte {
    _ = desc
    let dst = as_uint(payload)
    if word(handle + 16) == 0 {
        let node = pop_queue(handle + 56)
        if node != 0 {
            deliver(handle, word(node + 32), dst)
            wake_node(node)
            return 1
        }
        if word(handle + 24) != 0 { return 2 }
        return 0
    }
    if dequeue_value(handle, dst) == 1 { return 1 }
    if word(handle + 24) != 0 { return 2 }
    0
}

#[used]
pub fn join_wait(handle: uint, out: *(), desc: *()) byte {
    let cold = word(handle + 48)
    if word(cold + COROUTINE_COLD_COMPLETION_OFFSET) == 1 {
        return join_deliver(handle, cold, as_uint(out), as_uint(desc))
    }
    store_word(cold + COROUTINE_COLD_JOIN_WAITER_OFFSET, current_hot())
    park_current()
    join_deliver(handle, cold, as_uint(out), as_uint(desc))
}

/// 完成记录分流：panic 结果返回 2（panic 载荷由 `join_panic` 取走），正常结果复制后返回 1。
fn join_deliver(handle: uint, cold: uint, dst: uint, descriptor: uint) byte {
    if word(cold + COROUTINE_COLD_PANIC_RESULT_OFFSET) != 0 { return 2 }
    take_result(handle, dst, descriptor)
    1
}

/// 取走 panic 完成记录：结清结果登记与「未处理」记账，返回 Panic 句柄。
///
/// 调用方无条件调用：非 panic 结果提前返回 0 且不改任何状态。Panic 对象布局与
/// `panic_unwind` 里的 48 字节记录一致。
#[used]
pub fn join_panic(handle: uint) uint {
    let cold = word(handle + 48)
    if word(cold + COROUTINE_COLD_PANIC_RESULT_OFFSET) == 0 { return 0 }
    take_result(handle, 0, 0)
    word(cold + COROUTINE_COLD_RESULT_OFFSET)
}

fn record(base: uint, index: uint) uint = base + index * 64

fn commit_case(base: uint, index: uint) byte {
    let at = record(base, index)
    let op = word(at)
    let handle = word(at + 8)
    if op == 0 {
        if word(handle + 24) != 0 { return 2 }
        if channel_try_send(handle, as_ptr(word(at + 16)), as_ptr(0)) == 1 { return 1 }
        return 0
    }
    if op == 2 {
        let cold = word(handle + 48)
        if word(cold + COROUTINE_COLD_COMPLETION_OFFSET) == 1 {
            let result = word(at + 32)
            if word(cold + COROUTINE_COLD_PANIC_RESULT_OFFSET) != 0 {
                // panic 完成：把 Err 判别字与 Panic 句柄写进结果对象，再结清登记。
                let panic = join_panic(handle)
                store_word(result, 1)
                store_word(result + word(at + 48), panic)
                return 1
            }
            take_result(handle, result + word(at + 48), word(at + 40))
            return 1
        }
        return 0
    }
    let status = channel_try_recv(handle, as_ptr(word(at + 32) + word(at + 48)), as_ptr(0))
    if status == 1 {
        let result = word(at + 32)
        if result != 0 { byte_store(result, 0) }
        return 1
    }
    if status == 2 {
        let result = word(at + 32)
        if result != 0 { byte_store(result, 1) }
        return 1
    }
    0
}

#[used]
pub fn select_commit(records: *(), count: uint, has_default: byte) (uint, uint) {
    let base = as_uint(records)
    if count == 0 && has_default == 0 {
        park_current()
        return (0, 0)
    }
    let index: uint = 0
    while index < count {
        let status = commit_case(base, index)
        if status == 2 { return (index, 3) }
        if status == 1 { return (index, 0) }
        index = index + 1
    }
    if has_default != 0 { return (1000000, 0) }
    let cursor: uint = 0
    while cursor < count {
        let at = record(base, cursor)
        let op = word(at)
        let handle = word(at + 8)
        let queue = if op == 0 { handle + 56 } else { handle + 64 }
        if op == 2 { store_word(word(handle + 48) + COROUTINE_COLD_JOIN_WAITER_OFFSET, current_hot()) }
        else {
            let node = alloc_node(proc_of(current_hot()), current_hot(), word(at + 16), word(at + 32) + word(at + 48), cursor)
            push_queue(queue, node)
        }
        cursor = cursor + 1
    }
    park_current()
    (word(current_hot() + 40), 0)
}
