/* MarkMailbox、owner credit、cycle 终止记录、EdgeDelta 头部与 candidate 游标的 Gugu 定义；
 * 与 compiler runtime layout query 逐字段交叉校验。
 * 每项只保存 owner 序号、generation/epoch、block 身份、pending/done 计数与收敛条件观测值，
 * 禁止出现 managed pointer、field 地址或栈指针。
 */

use std.runtime.counters as counters
use std.runtime.native_memory as mapping
use std.runtime.heap.{heap_store_word, heap_word}

#[repr(C, align(64))]
pub struct MarkMailboxHead {
    pub owner_descriptor: uint,
    pub cycle_epoch: uint,
    pub topology_epoch: u32,
    pub pending: u32,
    pub consumed: uint,
    pub forwarded: uint,
    pub last_credit: uint,
    pub consumer_slots: u32,
    pub padding: [byte; 12],
}

#[repr(C, align(64))]
pub struct MarkCreditHead {
    pub owner_descriptor: uint,
    pub cycle_epoch: uint,
    pub granted: uint,
    pub issued: uint,
    pub in_flight: uint,
    pub done: uint,
    pub returned: uint,
    pub padding: [byte; 8],
}

#[repr(C, align(8))]
pub struct MarkTerminationRecord {
    pub cycle_epoch: uint,
    pub topology_epoch: u32,
    pub state: u32,
    pub conditions: [uint; 7],
}

#[repr(C, align(32))]
pub struct EdgeDeltaHead {
    pub source_block: u32,
    pub target_block: u32,
    pub source_generation: u32,
    pub target_generation: u32,
    pub cycle_epoch: uint,
    pub sequence: uint,
    pub delta: int,
    pub credit: uint,
    pub topology_epoch: u32,
    pub state: u32,
    pub target_owner: uint,
    pub target_owner_generation: uint,
    pub route_key: uint,
    pub bytes: u32,
    pub integrity: u32,
    pub domain: u32,
    pub reserved: u32,
}

#[repr(C, align(64))]
pub struct CandidateCursorHead {
    pub job: u32,
    pub phase: u32,
    pub cycle_epoch: uint,
    pub topology_epoch: u32,
    pub dirty: u32,
    pub work_units: uint,
    pub block_count: uint,
    pub edge_count: uint,
    pub cursor: uint,
    pub reserved: uint,
}

/// 非空 package 必经布局交叉校验。
#[used]
pub fn mark_records(
    mailbox: &MarkMailboxHead,
    credit: &MarkCreditHead,
    termination: &MarkTerminationRecord,
    edge: &EdgeDeltaHead,
    cursor: &CandidateCursorHead,
) uint {
    let total = mailbox.consumed + mailbox.forwarded + credit.in_flight + credit.granted
    total + termination.cycle_epoch + edge.sequence + cursor.work_units
}

#[repr(C)]
struct MarkExtent { base: uint, bytes: uint }

pub const MARK_TICKET_STATE_BYTES: uint = 4096
pub const MARK_TICKET_RECORD_BYTES: uint = 32
pub const MARK_TICKET_CAPACITY: uint = 96
pub const MARK_TICKET_COUNT_OFFSET: uint = 0
pub const MARK_TICKET_CONSUMED_OFFSET: uint = 8
pub const MARK_TICKET_CYCLE_OFFSET: uint = 16
pub const MARK_TICKET_RECORDS_OFFSET: uint = 64

pub fn mark_ticket_new(cycle: uint) uint {
    let state = unsafe { mapping.reserve_aligned(MARK_TICKET_STATE_BYTES, uint(4096)) }
    if state == 0 { unsafe { std.runtime.process_exit(2) } }
    let extent = MarkExtent { base: state, bytes: MARK_TICKET_STATE_BYTES }
    if unsafe { mapping.commit(std.mem.transmute[*MarkExtent, uint](std.ptr.addr_of(extent))) } != 0 {
        unsafe { std.runtime.process_exit(2) }
    }
    let at = state
    while at < state + MARK_TICKET_STATE_BYTES {
        heap_store_word(at, 0)
        at = at + 8
    }
    heap_store_word(state + MARK_TICKET_CYCLE_OFFSET, cycle)
    state
}

pub fn mark_ticket_issue(state: uint, owner: uint) uint {
    if state == 0 { return 0 }
    let count = heap_word(state + MARK_TICKET_COUNT_OFFSET)
    if count >= MARK_TICKET_CAPACITY { return 0 }
    let ticket = state + MARK_TICKET_RECORDS_OFFSET + count * MARK_TICKET_RECORD_BYTES
    heap_store_word(ticket, owner)
    heap_store_word(ticket + 8, count)
    heap_store_word(ticket + 16, 0)
    heap_store_word(ticket + 24, heap_word(state + MARK_TICKET_CYCLE_OFFSET))
    heap_store_word(state + MARK_TICKET_COUNT_OFFSET, count + 1)
    counters.add(counters.MARK_BATCHES, 1)
    counters.add(counters.MARK_PENDING, 1)
    ticket
}

pub fn mark_ticket_consume(state: uint, ticket: uint) uint {
    if state == 0 || ticket < state + MARK_TICKET_RECORDS_OFFSET { return 1 }
    if heap_word(ticket + 24) != heap_word(state + MARK_TICKET_CYCLE_OFFSET) { return 2 }
    if heap_word(ticket + 16) != 0 { return 3 }
    heap_store_word(ticket + 16, 1)
    heap_store_word(state + MARK_TICKET_CONSUMED_OFFSET, heap_word(state + MARK_TICKET_CONSUMED_OFFSET) + 1)
    0
}

pub fn mark_ticket_return(state: uint, ticket: uint) uint {
    if state == 0 || ticket < state + MARK_TICKET_RECORDS_OFFSET { return 1 }
    if heap_word(ticket + 16) != 1 { return 2 }
    heap_store_word(ticket + 16, 2)
    counters.remove(counters.MARK_PENDING, 1)
    0
}

pub fn mark_ticket_consumed(state: uint) uint = heap_word(state + MARK_TICKET_CONSUMED_OFFSET)
