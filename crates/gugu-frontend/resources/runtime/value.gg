/* 镜像值动作解释器直接消费已验证TypeRecord与value program。
 * Copy/Drop两个方向共存在同一程序；每次只执行所需方向，结构wrapper保留字段和variant顺序。
 * Bytes/string backing不可变，快照复制双字表示；资源通过同一descriptor递归获得/释放租约。
 */
use std.runtime.heap.{heap_word, heap_word32, heap_byte, heap_store_word, copy_bytes, heap_fail}
use std.runtime.roots.{gc_types_section, gc_type_record}
use std.runtime.resource.{acquire_control, release_control, publish_control}

const ACQUIRE: uint = 0
const RELEASE: uint = 1
const PUBLISH: uint = 2
const FORGET: uint = 3
const MAX_DEPTH: uint = 32

fn address(value: *()) uint { unsafe { std.mem.transmute[*(), uint](value) } }

/// 复制的字节由GIR/LIR处理；这个入口只负责类别动作。
#[used]
pub fn value_copy(value: *(), descriptor: *()) { apply(address(value), address(descriptor), ACQUIRE, 0) }
#[used]
pub fn value_publish(value: *(), descriptor: *()) { apply(address(value), address(descriptor), PUBLISH, 0) }
#[used]
pub fn value_drop(value: *(), descriptor: *()) { apply(address(value), address(descriptor), RELEASE, 0) }
#[used]
pub fn value_forget(value: *(), descriptor: *()) { apply(address(value), address(descriptor), FORGET, 0) }
#[used]
pub fn value_transfer(destination: *(), source: *(), descriptor: *()) {
    let src = address(source)
    let desc = address(descriptor)
    apply(src, desc, PUBLISH, 0)
    copy_bytes(address(destination), src, heap_word(desc))
}
#[used]
pub fn resource_acquire(value: *(), descriptor: *()) { apply(address(value), address(descriptor), ACQUIRE, 0) }
#[used]
pub fn resource_release(value: *(), descriptor: *()) { apply(address(value), address(descriptor), RELEASE, 0) }
#[used]
pub fn resource_transfer(value: *(), descriptor: *()) { apply(address(value), address(descriptor), PUBLISH, 0) }
#[used]
pub fn resource_finalize(value: *(), descriptor: *()) { apply(address(value), address(descriptor), RELEASE, 0) }

#[used]
pub fn cow_snapshot(destination: *(), source: *(), descriptor: *()) {
    let src = address(source)
    let desc = address(descriptor)
    apply(src, desc, PUBLISH, 0)
    copy_bytes(address(destination), src, heap_word(desc))
}

fn apply(value: uint, descriptor: uint, mode: uint, depth: uint) {
    if depth > MAX_DEPTH { heap_fail() }
    let length = heap_word32(descriptor + 36)
    if length == 0 { return }
    let section = gc_types_section()
    let program = section + heap_word(section + 48) + heap_word32(descriptor + 32)
    let flags = heap_word32(descriptor + 12)
    // ResourceCell是资源叶；其uint控制字没有子动作。包装类型由程序定位真正的资源字段。
    if (flags & uint(8)) != 0 && length == 1 {
        let control = heap_word(value)
        if mode == ACQUIRE { acquire_control(control) }
        if mode == RELEASE {
            heap_store_word(value, 0)
            release_control(control)
        }
        if mode == PUBLISH { publish_control(control) }
        if mode == FORGET { heap_store_word(value, 0) }
        return
    }
    program_run(program, program + length, value, descriptor, mode, depth)
}

/// canonical ULEB128在镜像写出前已验证，执行侧仍限制读取范围与64位移位。
/// 游标按值传入并返回续点，避免取地址产生托管盒；GC 释放资源时也执行这条路径。
fn uleb(cursor: uint, end: uint) (uint, uint) {
    let result: uint = 0
    let shift: uint = 0
    loop {
        if cursor >= end || shift >= 64 { heap_fail() }
        let part = uint(heap_byte(cursor))
        cursor = cursor + 1
        if shift == 63 && part > 1 { heap_fail() }
        result = result | ((part & uint(127)) << shift)
        if (part & uint(128)) == 0 { return (result, cursor) }
        shift = shift + 7
    }
}

fn read32(cursor: uint, end: uint) (uint, uint) {
    if cursor > end || end - cursor < 4 { heap_fail() }
    (heap_word32(cursor), cursor + 4)
}

fn read64(cursor: uint, end: uint) (uint, uint) {
    if cursor > end || end - cursor < 8 { heap_fail() }
    (heap_word(cursor), cursor + 8)
}

fn program_run(start: uint, end: uint, value: uint, descriptor: uint, mode: uint, depth: uint) {
    if depth > MAX_DEPTH { heap_fail() }
    let cursor = start
    while cursor < end {
        let op = uint(heap_byte(cursor))
        cursor = cursor + 1
        if op == 0 {
            if cursor != end { heap_fail() }
            return
        }
        if op >= uint(16) && op <= uint(20) {
            let decoded_offset = uleb(cursor, end)
            let offset = decoded_offset.0
            let decoded_index = uleb(decoded_offset.1, end)
            let index = decoded_index.0
            cursor = decoded_index.1
            let child = gc_type_record(gc_types_section(), index)
            if offset > heap_word(descriptor) || heap_word(child) > heap_word(descriptor) - offset { heap_fail() }
            let forward = op == uint(16) || op == uint(19)
            let backward = op == uint(17) || op == uint(20)
            if (mode == ACQUIRE && forward) || (mode == RELEASE && backward) || (mode == FORGET && backward) || (mode == PUBLISH && (forward || op == uint(18))) {
                apply(value + offset, child, mode, depth + 1)
            };
        } else {
            if op == uint(21) {
                cursor = repeat_run(cursor, end, value, descriptor, mode, depth)
            } else {
                if op == uint(22) { cursor = switch_run(cursor, end, value, descriptor, mode, depth) } else { heap_fail() }
            }
        }
    }
    heap_fail()
}

fn repeat_run(cursor: uint, end: uint, value: uint, descriptor: uint, mode: uint, depth: uint) uint {
    let decoded_base = uleb(cursor, end)
    let base = decoded_base.0 * 8
    let decoded_count = uleb(decoded_base.1, end)
    let count = decoded_count.0
    let decoded_stride = uleb(decoded_count.1, end)
    let stride = decoded_stride.0 * 8
    let decoded_length = read32(decoded_stride.1, end)
    let length = decoded_length.0
    let body = decoded_length.1
    if body > end || length > end - body { heap_fail() }
    let index: uint = 0
    while index < count {
        let item = if mode == RELEASE || mode == FORGET { count - 1 - index } else { index }
        program_run(body, body + length, value + base + item * stride, descriptor, mode, depth + 1)
        index = index + 1
    }
    body + length
}

fn switch_run(cursor: uint, end: uint, value: uint, descriptor: uint, mode: uint, depth: uint) uint {
    let decoded_offset = uleb(cursor, end)
    let offset = decoded_offset.0
    let decoded_width = uleb(decoded_offset.1, end)
    let width = decoded_width.0
    let decoded_count = uleb(decoded_width.1, end)
    let count = decoded_count.0
    cursor = decoded_count.1
    if width != 1 && width != 2 && width != 4 && width != 8 { heap_fail() }
    let tag: uint = 0
    let byte_index: uint = 0
    while byte_index < width {
        tag = tag | (uint(heap_byte(value + offset + byte_index)) << (byte_index * 8))
        byte_index = byte_index + 1
    }
    let selected: uint = 0
    let selected_length: uint = 0
    let index: uint = 0
    while index < count {
        let decoded_candidate = read64(cursor, end)
        let candidate = decoded_candidate.0
        let decoded_length = read32(decoded_candidate.1, end)
        let length = decoded_length.0
        cursor = decoded_length.1
        if cursor > end || length > end - cursor { heap_fail() }
        if candidate == tag {
            selected = cursor
            selected_length = length
        }
        cursor = cursor + length
        index = index + 1
    }
    let decoded_length = read32(cursor, end)
    let length = decoded_length.0
    cursor = decoded_length.1
    if cursor > end || length > end - cursor { heap_fail() }
    if selected == 0 {
        selected = cursor
        selected_length = length
    }
    cursor = cursor + length
    program_run(selected, selected + selected_length, value, descriptor, mode, depth + 1)
    cursor
}
