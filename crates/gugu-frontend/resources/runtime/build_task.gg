//! `std.runtime.build_task` —— build task 上下文与动作记录。
//!
//! host 在任务启动时写入环境变量，本模块读取；所有 `record_*` 调用按序向
//! `GUGU_BUILD_RECORD` 追加一行规范记录（TAB 分隔），任务结束后由宿主回收。
//! 非 build task 上下文中上下文读返回空/不活跃。
//!

use std.collections.{Vec}
// 内部协议读取必须绕过权限门（env 检查点在 std.env，本模块是工具链内部通道）。
use std.runtime.environment as env
use std.fs as fs
use std.io as io
use std.path.{OsString, Path}
use std.text.{Bytes, alloc_bytes}

fn env_text(name: string) string {
    match OsString::from_string(name) {
        Ok(key) => match env.get(key) {
            Ok(Some(value)) => match value.to_string() { Ok(text) => text, Err(_) => "" },
            _ => "",
        }
        Err(_) => "",
    }
}

fn env_flag(name: string) bool {
    let value = env_text(name)
    value == "1" || value == "true" || value == "yes"
}

pub fn active() bool = env_flag("GUGU_BUILD_TASK")

pub fn out_dir() string = env_text("GUGU_BUILD_OUT_DIR")

pub fn host() string = env_text("GUGU_BUILD_HOST")

pub fn target() string = env_text("GUGU_BUILD_TARGET")

pub fn features() Vec[string] {
    let names = Vec[string]::new()
    let raw = Bytes::from_string(env_text("GUGU_BUILD_FEATURES"))
    if raw.len() == 0 { return names }
    let start: int = 0
    let index: int = 0
    while index <= raw.len() {
        let end = if index == raw.len() { true } else {
            match raw.get(index) { Some(b) => b == byte(44), None => true }
        }
        if end {
            // 切片取 raw[start..index]：先截尾再断头。
            let piece = raw.split_at(index).0.split_at(start).1
            names.push(piece.to_string_lossy())
            start = index + 1
        }
        index = index + 1
    }
    names
}

pub fn known_feature(name: string) bool {
    for value in features() { if value == name { return true } else {} }
    false
}

fn record_path() Path = Path::from_string(env_text("GUGU_BUILD_RECORD"))

fn append(line: string) {
    let bytes = Bytes::from_string(line + "\n")
    let path = record_path()
    let options = fs.OpenOptions {
        read: false, write: true, append: true, truncate: false,
        create: true, create_new: false, follow_symlinks: true,
    }
    match fs.open(path, options) {
        Ok(file) => {
            match io::write_all(&file, bytes) {
                Err(_) => panic("build task 记录写入失败"),
                _ => {},
            }
            _ = file.close()
        }
        Err(_) => {
            match fs.write(path, bytes) {
                Err(_) => panic("build task 记录写入失败"),
                _ => {},
            }
        }
    }
}

fn escape(value: string) string {
    // TAB 是分隔符：参数里的 TAB 替换为空格，保持一行一条记录。
    let bytes = Bytes::from_string(value)
    let cleaned = unsafe { alloc_bytes(bytes.len()) }
    for index in 0..bytes.len() {
        let current = match bytes.get(index) { Some(b) => b, None => byte(32) }
        cleaned[index] = if current == byte(9) { byte(32) } else { current }
    }
    unsafe { Bytes::from_owned(cleaned) }.to_string_lossy()
}

pub fn add_rerun_file(path_or_glob: string) {
    append("rerun-file\t" + escape(path_or_glob))
}

pub fn add_rerun_env(name: string) {
    append("rerun-env\t" + escape(name) + "\t" + escape(env_text(name)))
}

pub fn mark_rerun_always() {
    append("rerun-always")
}

pub fn record_emit(name: string, path: string) {
    append("emit\t" + escape(name) + "\t" + escape(path))
}

pub fn record_define(name: string, has_value: bool, value: string) {
    if has_value {
        append("define\t" + escape(name) + "\t" + escape(value))
    } else {
        append("define\t" + escape(name))
    }
}

pub fn record_link(kind: string, name: string, path: string) {
    append("link\t" + escape(kind) + "\t" + escape(name) + "\t" + escape(path))
}

pub fn record_link_search(path: string) {
    append("link-search\t" + escape(path))
}

pub fn record_warning(message: string) {
    append("warning\t" + escape(message))
}

pub fn record_error(message: string) {
    append("error\t" + escape(message))
}

pub fn record_run_begin(executable: string, args: Vec[string], cwd: string, env_pairs: Vec[(string, string)], inherit_env: bool) uint {
    let ambient = if inherit_env { "inherit" } else { "clean" }
    append("run-begin\t" + escape(executable) + "\t" + escape(cwd) + "\t" + ambient)
    for pair in env_pairs {
        append("run-env\t" + escape(pair.0) + "\t" + escape(pair.1))
    }
    for value in args {
        append("run-arg\t" + escape(value))
    }
    0
}

pub fn record_run_code(index: uint, code: int) {
    append("run-code\t" + decimal(code))
}

fn decimal(value: int) string {
    // 手写十进制：避免依赖 fmt 私面；负数以 `-` 前缀表示。
    if value == 0 { return "0" }
    let negative = value < 0
    let magnitude = if negative { 0 - value } else { value }
    let digits = unsafe { alloc_bytes(20) }
    let count: int = 0
    let rest = magnitude
    while rest > 0 {
        digits[count] = byte(48 + uint(rest % 10))
        rest = rest / 10
        count = count + 1
    }
    let head = if negative { 1 } else { 0 }
    let out = unsafe { alloc_bytes(count + head) }
    let offset = if negative {
        out[0] = byte(45)
        1
    } else {
        0
    }
    for index in 0..count { out[offset + index] = digits[count - 1 - index] }
    unsafe { Bytes::from_owned(out) }.to_string_lossy()
}
