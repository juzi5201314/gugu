//! 稳定共享身份与访问租约；payload 复用 LargeMapping 的追踪和整映射回收。
use std.runtime.heap.{heap_word, heap_word32, heap_store_word, heap_store_word32, heap_fail, heap_large_allocate, heap_large_lookup, header_control, GENERATION_OLD, REPRESENTATION_SHARED_HANDLE, CONTROL_LARGE_OBJECT}
use std.runtime.gc.{gc_config_arena_bytes}
use std.runtime.native_memory as mapping
use std.runtime.counters as counters

pub const SHARED_HEAD_OFFSET: uint = 184
pub const SHARED_NEXT_TABLE_OFFSET: uint = 192
pub const SHARED_TRIM_LINK_OFFSET: uint = 200
pub const SHARED_TABLE_BYTES: uint = 8192
pub const SHARED_SLOT_COUNT: uint = 64
pub const SHARED_SLOTS_OFFSET: uint = 64
pub const SHARED_ADDRESSES_OFFSET: uint = 4160
pub const SHARED_PAYLOADS_OFFSET: uint = 4672
pub const SHARED_TAG: uint = 0xa000000000000000

#[repr(C)]
struct SharedExtent { base: uint, bytes: uint }
fn processor() uint = unsafe { heap_word(std.runtime.current_slot() + 16) }
fn coordinator() uint = heap_word(heap_word(processor() + 4080) + 760)
pub fn shared_head() uint = heap_word(coordinator() + SHARED_HEAD_OFFSET)
pub fn shared_slot(table: uint, index: uint) uint = table + SHARED_SLOTS_OFFSET + index * 64
pub fn shared_address(table: uint, index: uint) uint = heap_word(table + SHARED_ADDRESSES_OFFSET + index * 8)

fn shared_new_table() uint { unsafe {
    let owner = coordinator()
    let id = heap_word(owner + SHARED_NEXT_TABLE_OFFSET) + 1
    if id >= 4096 { heap_fail() }
    let base = mapping.reserve_aligned(SHARED_TABLE_BYTES, mapping.os_page_bytes())
    if base == 0 { heap_fail() }
    let extent = SharedExtent { base, bytes: SHARED_TABLE_BYTES }
    if mapping.commit(std.mem.transmute[*SharedExtent, uint](std.ptr.addr_of(extent))) != 0 {
        mapping.release_mapping(base, SHARED_TABLE_BYTES, 0)
        heap_fail()
    }
    let at = base
    while at < base + SHARED_TABLE_BYTES { heap_store_word(at, 0)
        at = at + 8 }
    heap_store_word(base, shared_head())
    heap_store_word(base + 8, id)
    heap_store_word(owner + SHARED_NEXT_TABLE_OFFSET, id)
    heap_store_word(owner + SHARED_TRIM_LINK_OFFSET, 0)
    counters.add(counters.RECLAIMABLE, SHARED_TABLE_BYTES)
    heap_store_word(owner + SHARED_HEAD_OFFSET, base)
    base
} }

fn shared_free_slot() (uint, uint) {
    let table = shared_head()
    while table != 0 {
        let index: uint = 0
        while index < SHARED_SLOT_COUNT {
            let slot = shared_slot(table, index)
            let state = heap_word32(slot + 4)
            if (state == 0 || state == 5) && heap_word32(slot) < 16777215 { return (table, index) };
            index = index + 1
        }
        table = heap_word(table)
    }
    (shared_new_table(), 0)
}

/// 分配后由紧随的 ResolveSharedHandle 消费一次初始化租约。
pub fn gc_shared_alloc(kind: uint, bytes: uint, align: uint, flags: uint) uint { unsafe {
    if flags != 4 || bytes > 4294967295 { heap_fail() }
    let free = shared_free_slot()
    let slot = shared_slot(free.0, free.1)
    let generation = heap_word32(slot) + 1
    let live = heap_word(free.0 + 16)
    if live == 0 { counters.remove(counters.RECLAIMABLE, SHARED_TABLE_BYTES) }
    heap_store_word(free.0 + 16, live + 1)
    heap_store_word32(slot + 4, 2)
    let config = std.runtime.gc_config()
    let payload = heap_large_allocate(processor(), gc_config_arena_bytes(config), 16, bytes, align, kind, 4096)
    heap_store_word(payload - 16, header_control(kind, GENERATION_OLD, 0, REPRESENTATION_SHARED_HANDLE) | CONTROL_LARGE_OBJECT)
    heap_store_word(free.0 + SHARED_ADDRESSES_OFFSET + free.1 * 8, payload)
    let record = free.0 + SHARED_PAYLOADS_OFFSET + free.1 * 32
    heap_store_word32(record, generation)
    heap_store_word32(record + 4, free.1)
    heap_store_word32(record + 8, heap_word(free.0 + 8) * SHARED_SLOT_COUNT + free.1)
    heap_store_word32(record + 16, generation)
    heap_store_word32(record + 24, bytes)
    heap_store_word32(record + 28, 1)
    heap_store_word32(slot, generation)
    heap_store_word(slot + 8, generation << 32 | free.1)
    heap_store_word(slot + 16, 0)
    heap_store_word(slot + 24, 0)
    heap_store_word(slot + 32, 1)
    heap_store_word(slot + 40, 0)
    heap_store_word(slot + 48, (heap_word(free.0 + 8) * SHARED_SLOT_COUNT + free.1) << 32)
    heap_store_word(slot + 56, bytes)
    heap_store_word32(slot + 4, 1)
    payload
} }

pub fn shared_locate(address: uint) (uint, uint) {
    let table = shared_head()
    while table != 0 {
        let index: uint = 0
        while index < SHARED_SLOT_COUNT {
            let slot = shared_slot(table, index)
            if heap_word32(slot + 4) == 1 {
                let payload = shared_address(table, index)
                if address >= payload && address - payload < heap_word32(slot + 56) { return (table, index) };
            }
            index = index + 1
        }
        table = heap_word(table)
    }
    (0, 0)
}

pub fn shared_pin(payload: uint, acquire: bool) {
    let found = shared_locate(payload)
    if found.0 == 0 { return }
    let slot = shared_slot(found.0, found.1)
    let count = heap_word32(slot + 36)
    if acquire {
        if count == 4294967295 { heap_fail() }
        heap_store_word32(slot + 36, count + 1)
    } else {
        if count == 0 { heap_fail() }
        heap_store_word32(slot + 36, count - 1)
    }
}

pub fn shared_decode(handle: uint) (uint, uint) {
    if handle >> 60 != 10 { heap_fail() }
    let identity = handle >> 48 & 4095
    let index = handle >> 24 & 16777215
    let generation = handle & 16777215
    if identity == 0 || generation == 0 || index >= SHARED_SLOT_COUNT { heap_fail() }
    let table = shared_head()
    while table != 0 && heap_word(table + 8) != identity { table = heap_word(table) }
    if table == 0 { heap_fail() }
    let slot = shared_slot(table, index)
    if heap_word32(slot) != generation || heap_word32(slot + 4) != 1 { heap_fail() }
    (table, index)
}

pub fn shared_payload(handle: uint) uint {
    if handle == 0 { return 0 }
    let decoded = shared_decode(handle)
    shared_address(decoded.0, decoded.1)
}

pub fn gc_resolve_shared_handle(payload: uint) uint {
    let found = shared_locate(payload)
    if found.0 == 0 || shared_address(found.0, found.1) != payload { heap_fail() }
    let slot = shared_slot(found.0, found.1)
    if heap_word32(slot + 32) != 1 { heap_fail() }
    heap_store_word32(slot + 32, 0)
    SHARED_TAG | heap_word(found.0 + 8) << 48 | found.1 << 24 | heap_word32(slot)
}

pub fn gc_shared_access_begin(handle: uint) uint {
    let found = shared_decode(handle)
    let slot = shared_slot(found.0, found.1)
    let count = heap_word32(slot + 32)
    if count == 4294967295 { heap_fail() }
    heap_store_word32(slot + 32, count + 1)
    counters.add(counters.HANDLE_RESOLVES, 1)
    shared_address(found.0, found.1)
}

pub fn gc_shared_access_end(handle: uint) {
    let found = shared_decode(handle)
    let slot = shared_slot(found.0, found.1)
    let count = heap_word32(slot + 32)
    if count == 0 { heap_fail() }
    heap_store_word32(slot + 32, count - 1)
}

pub fn gc_shared_field_barrier(pointer: uint, old: uint, value: uint) {
    let found = shared_locate(pointer)
    if found.0 == 0 || heap_word32(shared_slot(found.0, found.1) + 32) == 0 { heap_fail() }
    // 单 managed owner 在 STW 之外写入；minor 扫描独立映射字段，major 从精确根追踪。
    let _ = old
    let _ = value
}

/// LargeMapping sweep 已撤销不可达映射后，归还逻辑 slot；generation 保留至下次分配。
pub fn shared_sweep() { unsafe {
    let config = std.runtime.gc_config()
    let owner = processor()
    let young = heap_word(owner + 3592)
    let old = heap_word(coordinator() + 48)
    let table = shared_head()
    while table != 0 {
        let index: uint = 0
        while index < SHARED_SLOT_COUNT {
            let slot = shared_slot(table, index)
            if heap_word32(slot + 4) == 1 {
                let payload = shared_address(table, index)
                if heap_large_lookup(young, payload, config) == 0 && heap_large_lookup(old, payload, config) == 0 {
                    if heap_word(slot + 32) != 0 || heap_word(slot + 40) != 0 { heap_fail() }
                    heap_store_word32(slot + 4, 5)
                    let live = heap_word(table + 16)
                    if live == 0 { heap_fail() }
                    heap_store_word(table + 16, live - 1)
                    if live == 1 {
                        heap_store_word(coordinator() + SHARED_TRIM_LINK_OFFSET, 0)
                        counters.add(counters.RECLAIMABLE, SHARED_TABLE_BYTES)
                    }
                    heap_store_word(table + SHARED_ADDRESSES_OFFSET + index * 8, 0)
                    heap_store_word32(table + SHARED_PAYLOADS_OFFSET + index * 32 + 28, 0)
                };
            }
            index = index + 1
        }
        table = heap_word(table)
    }
    if heap_word(owner + 3888) != 0 { let _ = shared_trim() };
} }

/// 已确认无 payload/lease 的表才可归还；每轮最多访问 16 表并归还 64 KiB。
pub fn shared_trim() bool {
    let owner = coordinator()
    let saved = heap_word(owner + SHARED_TRIM_LINK_OFFSET)
    let link = if saved == 0 { owner + SHARED_HEAD_OFFSET } else { saved }
    let page = heap_word(link)
    let released: uint = 0
    let visited: uint = 0
    while page != 0 && visited < 16 {
        if heap_word(page + 16) == 0 && released + SHARED_TABLE_BYTES > mapping.OWNER_DRAIN_BYTES { break }
        let next = heap_word(page)
        if heap_word(page + 16) == 0 {
            heap_store_word(link, next)
            counters.remove(counters.RECLAIMABLE, SHARED_TABLE_BYTES)
            mapping.release_mapping(page, SHARED_TABLE_BYTES, SHARED_TABLE_BYTES)
            released = released + SHARED_TABLE_BYTES
        } else { link = page }
        page = next
        visited = visited + 1
    }
    heap_store_word(owner + SHARED_TRIM_LINK_OFFSET, if page == 0 { uint(0) } else { link })
    page == 0
}
