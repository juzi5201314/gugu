use std.collections.{Vec}
use std.path.{OsString, Path}
use std.fs as fs
use std.runtime.process_context as context
use std.runtime.environment as host

use std.runtime.permission as permission
pub use std.io.{Error}

pub fn args() Vec[OsString] = context.args()
pub fn get(name: OsString) Result[Option[OsString], Error] {
    permission::check_env(name)
    host.get(name)
}
pub fn vars() Result[Vec[(OsString, OsString)], Error] {
    match OsString::from_string("*") { Ok(all) => permission::check_env(all), Err(_) => {} }
    host.vars()
}
pub fn set(name: OsString, value: OsString) Result[(), Error] {
    permission::check_env(name)
    host.set(name, value)
}
pub fn remove(name: OsString) Result[(), Error] {
    permission::check_env(name)
    host.remove(name)
}
pub fn current_dir() Path = context.snapshot_cwd()
pub fn set_current_dir(path: Path) Result[(), Error] {
    permission::check_file(path, true)
    if path.as_os().is_empty() { return Err(Error::InvalidInput) }
    let resolved = context.resolve_at(context.snapshot_cwd(), path)
    if !fs.metadata(resolved, true)?.is_dir() { return Err(Error::NotADirectory) }
    context.replace_cwd(resolved)
}
