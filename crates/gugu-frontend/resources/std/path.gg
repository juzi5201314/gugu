use std.text.{Bytes, alloc_bytes}
use std.io as io

// Linux 保存任意原始字节；Windows 保存严格 UTF-8，native 边界无损转为 UTF-16。
pub struct OsString { bytes: Bytes }
pub struct Path { value: OsString }

pub struct UnicodeError {
    pub offset: int,
}

impl Error for UnicodeError {
    fn message(self: &Self) string = "invalid unicode"
    fn source(self: &Self) Option[&dyn Error] = None
}

impl Print for UnicodeError {
    fn print(self: &Self, out: &Formatter) {}
}

impl Debug for UnicodeError {
    fn debug(self: &Self, out: &Formatter) {}
}

fn has_nul(value: Bytes) bool {
    let data = unsafe { value.as_slice() }
    for index in 0..data.len() {
        if data[index] == 0 { return true };
    }
    false
}

pub fn from_string(value: string) Result[OsString, io.Error] {
    OsString::from_string(value)
}

#[cfg(os = "linux")]
pub fn from_bytes(value: Bytes) OsString = OsString::from_bytes(value)

#[cfg(os = "windows")]
pub fn from_bytes(value: Bytes) Result[OsString, UnicodeError] = OsString::from_bytes(value)

pub fn from_units(value: &[u16]) Result[OsString, io.Error] = OsString::from_units(value)

impl OsString {
    pub fn from_string(value: string) Result[OsString, io.Error] {
        let bytes = Bytes::from_string(value)
        if has_nul(bytes) { return Err(io.Error::InvalidInput) }
        Ok(OsString { bytes: bytes })
    }

    #[cfg(os = "linux")]
    pub fn from_bytes(value: Bytes) OsString = OsString { bytes: value }

    #[cfg(os = "windows")]
    pub fn from_bytes(value: Bytes) Result[OsString, UnicodeError] {
        match value.to_string() {
            Ok(_) => Ok(OsString { bytes: value }),
            Err(error) => Err(UnicodeError { offset: error.offset }),
        }
    }

    #[cfg(os = "linux")]
    pub fn from_units(value: &[u16]) Result[OsString, io.Error] {
        _ = value
        Err(io.Error::Unsupported)
    }

    #[cfg(os = "windows")]
    pub fn from_units(value: &[u16]) Result[OsString, io.Error] {
        let length = 0
        let index = 0
        while index < value.len() {
            let scalar = uint(value[index])
            if scalar == 0 { return Err(io.Error::InvalidInput) }
            if scalar >= 55296 && scalar <= 56319 {
                if index + 1 >= value.len() { return Err(io.Error::InvalidInput) }
                let low = uint(value[index + 1])
                if low < 56320 || low > 57343 { return Err(io.Error::InvalidInput) }
                scalar = 65536 + (scalar - 55296) * 1024 + low - 56320
                index = index + 1
            } else {
                if scalar >= 56320 && scalar <= 57343 { return Err(io.Error::InvalidInput) };
            }
            length = length + scalar_width(scalar)
            index = index + 1
        }
        let data = unsafe { alloc_bytes(length) }
        index = 0
        let out = 0
        while index < value.len() {
            let scalar = uint(value[index])
            if scalar >= 55296 && scalar <= 56319 {
                scalar = 65536 + (scalar - 55296) * 1024 + uint(value[index + 1]) - 56320
                index = index + 1
            }
            out = out + encode_scalar(data, out, scalar)
            index = index + 1
        }
        Ok(OsString { bytes: unsafe { Bytes::from_owned(data) } })
    }

    pub fn to_bytes(self: &Self) Bytes = self.bytes
    pub fn to_units(self: &Self) [u16; 0] = []

    pub fn to_string(self: &Self) Result[string, UnicodeError] {
        match self.bytes.to_string() {
            Ok(value) => Ok(value),
            Err(error) => Err(UnicodeError { offset: error.offset }),
        }
    }

    pub fn to_string_lossy(self: &Self) string = self.bytes.to_string_lossy()

    #[cfg(os = "linux")]
    pub fn len(self: &Self) int = self.bytes.len()

    #[cfg(os = "windows")]
    pub fn len(self: &Self) int {
        let data = unsafe { self.bytes.as_slice() }
        let index = 0
        let count = 0
        while index < data.len() {
            let width = encoded_width(data[index])
            count = count + 1
            if width == 4 { count = count + 1 }
            index = index + width
        }
        count
    }

    pub fn is_empty(self: &Self) bool = self.bytes.is_empty()
}

#[cfg(os = "linux")]
fn separator(value: byte) bool = value == 47

#[cfg(os = "windows")]
fn separator(value: byte) bool = value == 47 || value == 92

#[cfg(os = "linux")]
fn root_parent(data: &[byte], index: int) bool = index == 0

#[cfg(os = "windows")]
fn root_parent(data: &[byte], index: int) bool {
    if index == 0 || (index == 2 && data[1] == 58) { return true }
    index == 1 && separator(data[0])
}

#[cfg(os = "linux")]
fn native_separator() byte = 47

#[cfg(os = "windows")]
fn native_separator() byte = 92

fn section(value: OsString, start: int, end: int) OsString {
    let data = unsafe { value.bytes.as_slice() }
    OsString { bytes: unsafe { Bytes::from_owned(data[start..end]) } }
}

fn append(left: OsString, right: OsString, middle: bool, mark: byte) OsString {
    let extra = 0
    if middle { extra = 1 }
    let data = unsafe { alloc_bytes(left.bytes.len() + right.bytes.len() + extra) }
    _ = left.bytes.copy_to(data)
    if middle { data[left.bytes.len()] = mark }
    _ = right.bytes.copy_to(data[left.bytes.len() + extra..])
    OsString { bytes: unsafe { Bytes::from_owned(data) } }
}

// 返回最后一个非空组件的半开字节区间；不折叠 . 或 ..。
fn name_bounds(value: OsString) (int, int) {
    let data = unsafe { value.bytes.as_slice() }
    let end = data.len()
    while end > 0 {
        if !separator(data[end - 1]) { break }
        end = end - 1
    }
    let start = end
    while start > 0 {
        if separator(data[start - 1]) { break }
        start = start - 1
    }
    (start, end)
}

impl Path {
    pub fn from_string(value: string) Path {
        match OsString::from_string(value) {
            Ok(value) => Path { value: value },
            Err(_) => panic("path contains NUL"),
        }
    }

    pub fn from_os(value: OsString) Path = Path { value: value }
    pub fn as_os(self: &Self) OsString = self.value
    pub fn to_string(self: &Self) Result[string, UnicodeError] = self.value.to_string()
    pub fn to_string_lossy(self: &Self) string = self.value.to_string_lossy()

    pub fn join(self: &Self, child: Path) Path {
        if child.is_absolute() || self.value.is_empty() { return child }
        let data = unsafe { self.value.bytes.as_slice() }
        Path { value: append(self.value, child.value, !separator(data[data.len() - 1]), native_separator()) }
    }

    pub fn parent(self: &Self) Option[Path] {
        let data = unsafe { self.value.bytes.as_slice() }
        let index = data.len()
        while index > 0 {
            index = index - 1
            if separator(data[index]) {
                if root_parent(data, index) { return None }
                return Some(Path { value: section(self.value, 0, index) })
            };
        }
        None
    }

    pub fn file_name(self: &Self) Option[OsString] {
        let (start, end) = name_bounds(self.value)
        if start == end { None } else { Some(section(self.value, start, end)) }
    }

    pub fn extension(self: &Self) Option[OsString] {
        let (start, end) = name_bounds(self.value)
        let data = unsafe { self.value.bytes.as_slice() }
        let index = end
        while index > start {
            index = index - 1
            if data[index] == 46 {
                if index == start || index + 1 == end { return None }
                return Some(section(self.value, index + 1, end))
            };
        }
        None
    }

    pub fn with_file_name(self: &Self, name: OsString) Path {
        let (start, end) = name_bounds(self.value)
        if start == end { return self.join(Path::from_os(name)) }
        let prefix = section(self.value, 0, start)
        let suffix = section(self.value, end, self.value.bytes.len())
        Path { value: append(append(prefix, name, false, 0), suffix, false, 0) }
    }

    pub fn with_extension(self: &Self, extension: OsString) Path {
        match self.file_stem() {
            None => *self,
            Some(stem) => {
                let name = append(stem, extension, !extension.is_empty(), 46)
                self.with_file_name(name)
            },
        }
    }

    pub fn file_stem(self: &Self) Option[OsString] {
        let (start, end) = name_bounds(self.value)
        if start == end { return None }
        match self.extension() {
            None => Some(section(self.value, start, end)),
            Some(extension) => Some(section(self.value, start, end - extension.bytes.len() - 1)),
        }
    }

    pub fn components(self: &Self) [OsString; 0] = []

    #[cfg(os = "linux")]
    pub fn is_absolute(self: &Self) bool {
        let data = unsafe { self.value.bytes.as_slice() }
        data.len() > 0 && data[0] == 47
    }

    #[cfg(os = "windows")]
    pub fn is_absolute(self: &Self) bool {
        let data = unsafe { self.value.bytes.as_slice() }
        if data.len() >= 2 && separator(data[0]) && separator(data[1]) { return true }
        if data.len() < 3 { return false }
        let letter = data[0]
        ((letter >= 65 && letter <= 90) || (letter >= 97 && letter <= 122)) && data[1] == 58 && separator(data[2])
    }

    pub fn is_relative(self: &Self) bool = !self.is_absolute()
}

#[cfg(os = "windows")]
fn scalar_width(value: uint) int {
    if value < 128 { return 1 }
    if value < 2048 { return 2 }
    if value < 65536 { return 3 }
    4
}

#[cfg(os = "windows")]
fn encode_scalar(data: &[byte], start: int, scalar: uint) int {
    let width = scalar_width(scalar)
    if width == 1 { data[start] = byte(scalar) }
    if width == 2 {
        data[start] = byte(192 | (scalar >> 6))
        data[start + 1] = byte(128 | (scalar & 63))
    }
    if width == 3 {
        data[start] = byte(224 | (scalar >> 12))
        data[start + 1] = byte(128 | ((scalar >> 6) & 63))
        data[start + 2] = byte(128 | (scalar & 63))
    }
    if width == 4 {
        data[start] = byte(240 | (scalar >> 18))
        data[start + 1] = byte(128 | ((scalar >> 12) & 63))
        data[start + 2] = byte(128 | ((scalar >> 6) & 63))
        data[start + 3] = byte(128 | (scalar & 63))
    }
    width
}

#[cfg(os = "windows")]
fn encoded_width(first: byte) int {
    if first < 128 { return 1 }
    if first < 224 { return 2 }
    if first < 240 { return 3 }
    4
}

#[cfg(os = "linux")]
pub fn from_native_bytes(bytes: Bytes) Result[OsString, io.Error] = Ok(OsString::from_bytes(bytes))

#[cfg(os = "windows")]
pub fn from_native_bytes(bytes: Bytes) Result[OsString, io.Error] {
    if bytes.len() % 2 != 0 { return Err(io.Error::InvalidData) }
    let input = unsafe { bytes.as_slice() }
    let output = unsafe { alloc_bytes(bytes.len() * 2) }
    let index = 0
    let count = 0
    while index < input.len() {
        let scalar = uint(input[index]) | (uint(input[index + 1]) << 8)
        index = index + 2
        if scalar >= 55296 && scalar <= 56319 {
            if index >= input.len() { return Err(io.Error::InvalidData) }
            let low = uint(input[index]) | (uint(input[index + 1]) << 8)
            if low < 56320 || low > 57343 { return Err(io.Error::InvalidData) }
            scalar = 65536 + (scalar - 55296) * 1024 + low - 56320
            index = index + 2
        } else { if scalar >= 56320 && scalar <= 57343 { return Err(io.Error::InvalidData) }; }
        count = count + encode_scalar(output, count, scalar)
    }
    Ok(OsString { bytes: unsafe { Bytes::from_owned(output[..count]) } })
}

// 返回带终止符的 native 编码快照，fs 必须在提交阻塞调用前复制到 raw payload。
#[cfg(os = "linux")]
pub fn native_bytes(path: Path) Result[Bytes, io.Error] {
    let bytes = path.value.bytes
    if has_nul(bytes) { return Err(io.Error::InvalidInput) }
    let data = unsafe { alloc_bytes(bytes.len() + 1) }
    _ = bytes.copy_to(data)
    data[bytes.len()] = 0
    Ok(unsafe { Bytes::from_owned(data) })
}

#[cfg(os = "windows")]
pub fn native_bytes(path: Path) Result[Bytes, io.Error] {
    let bytes = path.value.bytes
    if has_nul(bytes) { return Err(io.Error::InvalidInput) }
    let data = unsafe { alloc_bytes((path.value.len() + 1) * 2) }
    let source = unsafe { bytes.as_slice() }
    let index = 0
    let out = 0
    while index < source.len() {
        let width = encoded_width(source[index])
        let scalar = uint(source[index])
        if width == 2 { scalar = scalar & 31 }
        if width == 3 { scalar = scalar & 15 }
        if width == 4 { scalar = scalar & 7 }
        for part in 1..width { scalar = scalar * 64 + (uint(source[index + part]) & 63) }
        if scalar >= 65536 {
            scalar = scalar - 65536
            let high = 55296 + (scalar >> 10)
            data[out] = byte(high & 255)
            data[out + 1] = byte(high >> 8)
            out = out + 2
            scalar = 56320 + (scalar & 1023)
        }
        data[out] = byte(scalar & 255)
        data[out + 1] = byte(scalar >> 8)
        out = out + 2
        index = index + width
    }
    data[out] = 0
    data[out + 1] = 0
    Ok(unsafe { Bytes::from_owned(data) })
}
