impl Print for uint {
    fn print(self: &Self, out: &Formatter) {
        out.pad_integral(true, "", digits(uint(*self), 10, false))
    }
}

impl Debug for uint {
    fn debug(self: &Self, out: &Formatter) {
        out.pad_integral(true, "", digits(uint(*self), 10, false))
    }
}

impl Binary for uint {
    fn binary(self: &Self, out: &Formatter) {
        out.pad_integral(true, "0b", digits(uint(*self), 2, false))
    }
}

impl Octal for uint {
    fn octal(self: &Self, out: &Formatter) {
        out.pad_integral(true, "0o", digits(uint(*self), 8, false))
    }
}

impl LowerHex for uint {
    fn lower_hex(self: &Self, out: &Formatter) {
        out.pad_integral(true, "0x", digits(uint(*self), 16, false))
    }
}

impl UpperHex for uint {
    fn upper_hex(self: &Self, out: &Formatter) {
        out.pad_integral(true, "0x", digits(uint(*self), 16, true))
    }
}

impl Print for u128 {
    fn print(self: &Self, out: &Formatter) {
        out.pad_integral(true, "", wide_digits(*self, 10, false))
    }
}

impl Debug for u128 {
    fn debug(self: &Self, out: &Formatter) {
        out.pad_integral(true, "", wide_digits(*self, 10, false))
    }
}

impl Binary for u128 {
    fn binary(self: &Self, out: &Formatter) {
        out.pad_integral(true, "0b", wide_digits(*self, 2, false))
    }
}

impl Octal for u128 {
    fn octal(self: &Self, out: &Formatter) {
        out.pad_integral(true, "0o", wide_digits(*self, 8, false))
    }
}

impl LowerHex for u128 {
    fn lower_hex(self: &Self, out: &Formatter) {
        out.pad_integral(true, "0x", wide_digits(*self, 16, false))
    }
}

impl UpperHex for u128 {
    fn upper_hex(self: &Self, out: &Formatter) {
        out.pad_integral(true, "0x", wide_digits(*self, 16, true))
    }
}
