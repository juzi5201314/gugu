use std.text.{Bytes, ByteBuffer, alloc_bytes, encode_char}
use std.fmt_float as float_format

pub struct Formatter {
    text: ByteBuffer,
    fill: char,
    alignment: int,
    sign: int,
    alternate: bool,
    zero: bool,
    width: int,
    precision: int,
}

impl Formatter {
    pub fn new() Formatter = Formatter {
        text: ByteBuffer::new(), fill: ' ', alignment: 0, sign: 0,
        alternate: false, zero: false, width: 0, precision: -1,
    }
    pub fn finish(self: &Self) string = self.text.freeze().to_string_lossy()
    pub fn write_str(self: &Self, value: string) { self.text.append(Bytes::from_string(value)) }
    pub fn write_char(self: &Self, value: char) { self.write_str(encode_char(value)) }
    pub fn debug_struct(self: &Self, name: string) DebugStruct = DebugStruct { inner: self.builder(name, 0) }
    pub fn debug_tuple(self: &Self, name: string) DebugTuple = DebugTuple { inner: self.builder(name, 1) }
    pub fn debug_list(self: &Self) DebugList = DebugList { inner: self.builder("", 2) }
    pub fn debug_set(self: &Self) DebugSet = DebugSet { inner: self.builder("", 3) }
    pub fn debug_map(self: &Self) DebugMap = DebugMap { inner: self.builder("", 4) }
    fn builder(self: &Self, name: string, kind: int) DebugBuilder {
        self.write_str(name)
        if kind != 0 { self.write_str(if kind == 1 { "(" } else if kind == 2 { "[" } else { "{" }) }
        DebugBuilder { out: self, kind, entries: 0, finished: false }
    }
    pub fn pad(self: &Self, value: string) {
        let bytes = unsafe { Bytes::from_string(value).as_slice() }
        let end = 0
        let length = 0
        while end < bytes.len() && (self.precision < 0 || length < self.precision) {
            end = end + scalar_width(bytes[end])
            length = length + 1
        }
        self.aligned(value[..end], length, 1)
    }
    pub fn pad_integral(self: &Self, non_negative: bool, prefix: string, digits: string) {
        let sign = if !non_negative { "-" } else if self.sign == 1 { "+" } else if self.sign == 3 { " " } else { "" }
        let prefix = if self.alternate { prefix } else { "" }
        let head = sign + prefix
        let length = scalar_count(head) + scalar_count(digits)
        if self.zero {
            self.write_str(head)
            self.repeat('0', self.width - length)
            self.write_str(digits)
        } else {
            self.aligned(head + digits, length, 3)
        }
    }
    fn aligned(self: &Self, text: string, length: int, default: int) {
        let padding = if self.width > length { self.width - length } else { 0 }
        let alignment = if self.alignment == 0 { default } else { self.alignment }
        let before = if alignment == 3 { padding } else if alignment == 2 { padding / 2 } else { 0 }
        self.repeat(self.fill, before)
        self.write_str(text)
        self.repeat(self.fill, padding - before)
    }
    fn repeat(self: &Self, fill: char, count: int) {
        let text = encode_char(fill)
        for _ in 0..count { self.write_str(text) }
    }
    fn float(self: &Self, bits: uint, fraction: int, exponent: int, mode: int) {
        let negative = bits >> (fraction + exponent) != 0
        let magnitude = bits & ((uint(1) << (fraction + exponent)) - 1)
        let special = ((uint(1) << exponent) - 1) << fraction
        if magnitude >= special {
            let text = if magnitude != special { "NaN" } else if negative { "-inf" }
                else if self.sign == 1 { "+inf" } else if self.sign == 3 { " inf" } else { "inf" }
            self.aligned(text, scalar_count(text), 3)
        } else {
            self.pad_integral(!negative, "", float_format.format(magnitude, fraction, exponent, mode, self.precision))
        }
    }
}

struct DebugBuilder { out: &Formatter, kind: int, entries: int, finished: bool }
impl DebugBuilder {
    fn separator(self: &Self) {
        if self.finished { panic("debug builder already finished") }
        let first = self.entries == 0
        self.entries = self.entries + 1
        if self.kind == 0 && first {
            self.out.write_str(if self.out.alternate { " {\n    " } else { " { " })
        } else if self.out.alternate {
            self.out.write_str(if first { "\n    " } else { ",\n    " })
        } else if !first { self.out.write_str(", ") } else {}
    }
    fn child(self: &Self) Formatter {
        let child = Formatter::new()
        child.alternate = self.out.alternate
        child
    }
    fn rendered(self: &Self, text: string) {
        if !self.out.alternate { self.out.write_str(text); return }
        let bytes = unsafe { Bytes::from_string(text).as_slice() }
        let start = 0
        for i in 0..bytes.len() {
            if bytes[i] == 10 {
                self.out.write_str(text[start..i + 1])
                self.out.write_str("    ")
                start = i + 1
            }
        }
        self.out.write_str(text[start..])
    }
    fn entry[T: Debug](self: &Self, value: &T) {
        self.separator()
        let child = self.child()
        value.debug(&child)
        self.rendered(child.finish())
    }
    fn finish(self: &Self) {
        if self.finished { return }
        self.finished = true
        if self.kind == 0 && self.entries == 0 { return }
        if self.entries > 0 {
            if self.out.alternate { self.out.write_str(",\n") }
            else if self.kind == 0 { self.out.write_str(" ") } else {}
        }
        self.out.write_str(if self.kind == 1 { ")" } else if self.kind == 2 { "]" } else { "}" })
    }
}

pub struct DebugStruct { inner: DebugBuilder }
impl DebugStruct {
    pub fn field[T: Debug](self: &Self, name: string, value: &T) &Self {
        self.inner.separator()
        self.inner.rendered(name)
        self.inner.out.write_str(": ")
        let child = self.inner.child()
        value.debug(&child)
        self.inner.rendered(child.finish())
        self
    }
    pub fn finish(self: &Self) { self.inner.finish() }
}
pub struct DebugTuple { inner: DebugBuilder }
impl DebugTuple {
    pub fn entry[T: Debug](self: &Self, value: &T) &Self { self.inner.entry(value); self }
    pub fn finish(self: &Self) { self.inner.finish() }
}
pub struct DebugList { inner: DebugBuilder }
impl DebugList {
    pub fn entry[T: Debug](self: &Self, value: &T) &Self { self.inner.entry(value); self }
    pub fn finish(self: &Self) { self.inner.finish() }
}
pub struct DebugSet { inner: DebugBuilder }
impl DebugSet {
    pub fn entry[T: Debug](self: &Self, value: &T) &Self { self.inner.entry(value); self }
    pub fn finish(self: &Self) { self.inner.finish() }
}
pub struct DebugMap { inner: DebugBuilder }
impl DebugMap {
    pub fn entry[K: Debug, V: Debug](self: &Self, key: &K, value: &V) &Self {
        self.inner.separator()
        let child = self.inner.child()
        key.debug(&child)
        self.inner.rendered(child.finish())
        self.inner.out.write_str(": ")
        let child_value = self.inner.child()
        value.debug(&child_value)
        self.inner.rendered(child_value.finish())
        self
    }
    pub fn finish(self: &Self) { self.inner.finish() }
}

impl Print for () { fn print(self: &Self, out: &Formatter) { out.pad("()") } }
impl Debug for () { fn debug(self: &Self, out: &Formatter) { out.pad("()") } }

impl[T: Debug] Print for Option[T] {
    fn print(self: &Self, out: &Formatter) { self.debug(out) }
}
impl[T: Debug] Debug for Option[T] {
    fn debug(self: &Self, out: &Formatter) {
        match *self {
            Some(value) => out.debug_tuple("Some").entry(&value).finish(),
            None => out.write_str("None"),
        }
    }
}
impl[T: Debug, E: Debug] Print for Result[T, E] {
    fn print(self: &Self, out: &Formatter) { self.debug(out) }
}
impl[T: Debug, E: Debug] Debug for Result[T, E] {
    fn debug(self: &Self, out: &Formatter) {
        match *self {
            Ok(value) => out.debug_tuple("Ok").entry(&value).finish(),
            Err(error) => out.debug_tuple("Err").entry(&error).finish(),
        }
    }
}
fn format_array[T: Debug, comptime N: int](values: &[T; N], out: &Formatter) {
    let builder = out.debug_list()
    for i in 0..N { builder.entry(&values[i]) }
    builder.finish()
}

fn format_tuple[Ts: Debug...](values: &Ts, out: &Formatter) {
    let builder = out.debug_tuple("")
    let fields = *values
    for field in fields { builder.entry(&field) }
    builder.finish()
}

impl Print for f64 { fn print(self: &Self, out: &Formatter) { out.float(unsafe { std.mem.transmute[f64, uint](*self) }, 52, 11, 0) } }
impl Debug for f64 { fn debug(self: &Self, out: &Formatter) { out.float(unsafe { std.mem.transmute[f64, uint](*self) }, 52, 11, 1) } }
impl LowerExp for f64 { fn lower_exp(self: &Self, out: &Formatter) { out.float(unsafe { std.mem.transmute[f64, uint](*self) }, 52, 11, 2) } }
impl UpperExp for f64 { fn upper_exp(self: &Self, out: &Formatter) { out.float(unsafe { std.mem.transmute[f64, uint](*self) }, 52, 11, 3) } }
impl Print for f32 { fn print(self: &Self, out: &Formatter) { out.float(uint(unsafe { std.mem.transmute[f32, u32](*self) }), 23, 8, 0) } }
impl Debug for f32 { fn debug(self: &Self, out: &Formatter) { out.float(uint(unsafe { std.mem.transmute[f32, u32](*self) }), 23, 8, 1) } }
impl LowerExp for f32 { fn lower_exp(self: &Self, out: &Formatter) { out.float(uint(unsafe { std.mem.transmute[f32, u32](*self) }), 23, 8, 2) } }
impl UpperExp for f32 { fn upper_exp(self: &Self, out: &Formatter) { out.float(uint(unsafe { std.mem.transmute[f32, u32](*self) }), 23, 8, 3) } }

fn scalar_width(first: byte) int {
    if first < 128 { 1 } else if first < 224 { 2 } else if first < 240 { 3 } else { 4 }
}

fn scalar_count(value: string) int {
    let bytes = unsafe { Bytes::from_string(value).as_slice() }
    let length = 0
    for first in bytes {
        if first < 128 || first >= 192 { length = length + 1 }
    }
    length
}

fn digits(value: uint, base: uint, upper: bool) string {
    let alphabet = unsafe { Bytes::from_string(if upper { "0123456789ABCDEF" } else { "0123456789abcdef" }).as_slice() }
    let storage = unsafe { alloc_bytes(64) }
    let cursor = 64
    let remaining = value
    loop {
        cursor = cursor - 1
        storage[cursor] = alphabet[int(remaining % base)]
        remaining = remaining / base
        if remaining == 0 { break };
    }
    utf8(storage[cursor..])
}

fn utf8(data: &[byte]) string {
    let bytes = unsafe { Bytes::from_owned(data) }
    bytes.to_string_lossy()
}

fn signed_decimal(value: int, out: &Formatter) {
    let magnitude = if value < 0 { uint(-(value + 1)) + 1 } else { uint(value) }
    out.pad_integral(value >= 0, "", digits(magnitude, 10, false))
}

fn escaped(value: string, quote: char) string {
    let out = Formatter::new()
    out.write_char(quote)
    let bytes = unsafe { Bytes::from_string(value).as_slice() }
    let index = 0
    while index < bytes.len() {
        let first = bytes[index]
        let width = scalar_width(first)
        let code = uint(first)
        if width > 1 {
            code = uint(first & (if width == 2 { byte(31) } else if width == 3 { byte(15) } else { byte(7) }))
            for offset in 1..width { code = (code << 6) | uint(bytes[index + offset] & 63) }
        }
        if first == 0 { out.write_str("\\0") }
        else if first == 9 { out.write_str("\\t") }
        else if first == 10 { out.write_str("\\n") }
        else if first == 13 { out.write_str("\\r") }
        else if first == 92 { out.write_str("\\\\") }
        else if uint(first) == uint(quote) { out.write_char('\\'); out.write_char(quote) }
        else if code < 32 || (code >= 127 && code <= 159) || code == 173 || code == 1564 || (code >= 8203 && code <= 8207) || (code >= 8232 && code <= 8238) || (code >= 8288 && code <= 8303) || code == 65279 || (code >= 65529 && code <= 65531) {
            out.write_str("\\u{")
            out.write_str(digits(code, 16, false))
            out.write_str("}")
        } else {
            out.write_str(value[index..index + width])
        }
        index = index + width
    }
    out.write_char(quote)
    out.finish()
}

impl Print for string {
    fn print(self: &Self, out: &Formatter) { out.pad(*self) }
}
impl Debug for string {
    fn debug(self: &Self, out: &Formatter) {
        let text = escaped(*self, '"')
        let bytes = unsafe { Bytes::from_string(text).as_slice() }
        let length = 0
        let index = 0
        while index < bytes.len() {
            index = index + scalar_width(bytes[index])
            length = length + 1
        }
        out.aligned(text, length, 1)
    }
}
impl Print for char {
    fn print(self: &Self, out: &Formatter) { out.pad(encode_char(*self)) }
}
impl Debug for char {
    fn debug(self: &Self, out: &Formatter) { out.pad(escaped(encode_char(*self), '\'')) }
}
impl Print for bool {
    fn print(self: &Self, out: &Formatter) { out.pad(if *self { "true" } else { "false" }) }
}
impl Debug for bool {
    fn debug(self: &Self, out: &Formatter) { out.pad(if *self { "true" } else { "false" }) }
}

fn wide_divmod(value: u128, base: uint) (u128, uint) {
    let quotient: u128 = 0
    let remainder: uint = 0
    let bit = 127
    while bit >= 0 {
        remainder = (remainder << 1) | uint((value >> bit) & 1)
        if remainder >= base {
            remainder = remainder - base
            quotient = quotient | (u128(1) << bit)
        }
        bit = bit - 1
    }
    (quotient, remainder)
}

fn wide_digits(value: u128, base: uint, upper: bool) string {
    let alphabet = unsafe { Bytes::from_string(if upper { "0123456789ABCDEF" } else { "0123456789abcdef" }).as_slice() }
    let storage = unsafe { alloc_bytes(128) }
    let cursor = 128
    let remaining = value
    loop {
        let (quotient, remainder) = wide_divmod(remaining, base)
        cursor = cursor - 1
        storage[cursor] = alphabet[int(remainder)]
        remaining = quotient
        if remaining == 0 { break };
    }
    utf8(storage[cursor..])
}

fn __formatter_new() Formatter = Formatter::new()
fn __formatter_write(out: &Formatter, value: string) { out.write_str(value) }
fn __formatter_finish(out: &Formatter) string = out.finish()
fn __formatter_spec(out: &Formatter, fill: char, alignment: int, sign: int, alternate: bool, zero: bool, has_width: bool, width: int, has_precision: bool, precision: int) {
    if (has_width && width < 0) || (has_precision && precision < 0) { panic("negative format count") }
    out.fill = fill
    out.alignment = alignment
    out.sign = sign
    out.alternate = alternate
    out.zero = zero
    out.width = if has_width { width } else { 0 }
    out.precision = if has_precision { precision } else { -1 }
}

impl Print for i8 {
    fn print(self: &Self, out: &Formatter) {
        signed_decimal(int(*self), out)
    }
}

impl Debug for i8 {
    fn debug(self: &Self, out: &Formatter) {
        signed_decimal(int(*self), out)
    }
}

impl Binary for i8 {
    fn binary(self: &Self, out: &Formatter) {
        out.pad_integral(true, "0b", digits(unsafe { std.mem.transmute[int, uint](int(*self)) }, 2, false))
    }
}

impl Octal for i8 {
    fn octal(self: &Self, out: &Formatter) {
        out.pad_integral(true, "0o", digits(unsafe { std.mem.transmute[int, uint](int(*self)) }, 8, false))
    }
}

impl LowerHex for i8 {
    fn lower_hex(self: &Self, out: &Formatter) {
        out.pad_integral(true, "0x", digits(unsafe { std.mem.transmute[int, uint](int(*self)) }, 16, false))
    }
}

impl UpperHex for i8 {
    fn upper_hex(self: &Self, out: &Formatter) {
        out.pad_integral(true, "0x", digits(unsafe { std.mem.transmute[int, uint](int(*self)) }, 16, true))
    }
}

