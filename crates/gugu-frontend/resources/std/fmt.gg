impl Print for i128 {
    fn print(self: &Self, out: &Formatter) {
        let value = *self
        let magnitude = if value < 0 { u128(-(value + 1)) + 1 } else { u128(value) }
        out.pad_integral(value >= 0, "", wide_digits(magnitude, 10, false))
    }
}

impl Debug for i128 {
    fn debug(self: &Self, out: &Formatter) {
        let value = *self
        let magnitude = if value < 0 { u128(-(value + 1)) + 1 } else { u128(value) }
        out.pad_integral(value >= 0, "", wide_digits(magnitude, 10, false))
    }
}

impl Binary for i128 {
    fn binary(self: &Self, out: &Formatter) {
        out.pad_integral(true, "0b", wide_digits(unsafe { std.mem.transmute[i128, u128](*self) }, 2, false))
    }
}

impl Octal for i128 {
    fn octal(self: &Self, out: &Formatter) {
        out.pad_integral(true, "0o", wide_digits(unsafe { std.mem.transmute[i128, u128](*self) }, 8, false))
    }
}

