// 只读快照持有受管切片；切片的 interior root 保持整个 backing 可达。
pub struct Bytes {
    data: &[byte],
}

#[used]
pub fn string_compare(left: &[byte], right: &[byte]) int {
    let length = if left.len() < right.len() { left.len() } else { right.len() }
    for index in 0..length {
        if left[index] < right[index] { return -1 }
        if left[index] > right[index] { return 1 };
    }
    if left.len() < right.len() { return -1 }
    if left.len() > right.len() { return 1 }
    0
}

fn share_bytes() {
    let value = Bytes::new()
    let copy = value
    _ = value
    _ = copy
}

pub struct EncodingError {
    pub offset: int,
}

impl Error for EncodingError {
    fn message(self: &Self) string = "invalid unicode"
    fn source(self: &Self) Option[&dyn Error] = None
}

impl Print for EncodingError {
    fn print(self: &Self, out: &Formatter) {}
}

impl Debug for EncodingError {
    fn debug(self: &Self, out: &Formatter) {}
}

// 标准库内部写入新 backing 的唯一入口；返回值由现有 GC 分配管线管理。
pub unsafe fn alloc_bytes(length: int) &[byte] {
    if length < 0 { panic("negative byte length") }
    unsafe { std.runtime.alloc_bytes(uint(length)) }
}

impl Bytes {
    pub fn new() Bytes {
        let empty: [byte; 0] = []
        Bytes { data: &empty }
    }

    pub fn copy_from(source: &[byte]) Bytes {
        let data = unsafe { alloc_bytes(source.len()) }
        for index in 0..source.len() { data[index] = source[index] }
        Bytes { data: data }
    }

    pub fn from_string(value: string) Bytes {
        Bytes { data: unsafe { std.runtime.string_bytes(value) } }
    }

    // 调用者必须交出全部可写别名；之后只能通过只读 Bytes 观察该区间。
    pub unsafe fn from_owned(data: &[byte]) Bytes = Bytes { data: data }

    // 仅供标准库 native bridge 读取；调用者不得写入或跨 safepoint 保存裸地址。
    pub unsafe fn as_slice(self: &Self) &[byte] = self.data

    pub fn len(self: &Self) int = self.data.len()
    pub fn is_empty(self: &Self) bool = self.data.len() == 0

    pub fn get(self: &Self, index: int) Option[byte] {
        if index < 0 { panic("negative byte index") }
        if index >= self.data.len() { None } else { Some(self.data[index]) }
    }

    pub fn split_at(self: &Self, index: int) (Bytes, Bytes) {
        if index < 0 || index > self.data.len() { panic("byte split out of range") }
        (Bytes { data: self.data[..index] }, Bytes { data: self.data[index..] })
    }

    pub fn starts_with(self: &Self, prefix: Bytes) bool {
        if prefix.len() > self.len() { return false }
        for index in 0..prefix.len() {
            if self.data[index] != prefix.data[index] { return false };
        }
        true
    }

    pub fn ends_with(self: &Self, suffix: Bytes) bool {
        if suffix.len() > self.len() { return false }
        let start = self.len() - suffix.len()
        for index in 0..suffix.len() {
            if self.data[start + index] != suffix.data[index] { return false };
        }
        true
    }

    pub fn copy_to(self: &Self, destination: &[byte]) int {
        let count = self.len()
        if destination.len() < count { count = destination.len() }
        for index in 0..count { destination[index] = self.data[index] }
        count
    }

    pub fn to_string(self: &Self) Result[string, EncodingError] = utf8_decode(*self)
    pub fn to_string_lossy(self: &Self) string = utf8_decode_lossy(*self)
}

// 合法标量返回正长度；非法序列返回 maximal subpart 的负长度。
fn utf8_width(source: &[byte], start: int) int {
    let first = uint(source[start])
    if first < 128 { return 1 }
    let width = 0
    let low = uint(128)
    let high = uint(191)
    if first >= 194 && first <= 223 { width = 2 }
    if first >= 224 && first <= 239 {
        width = 3
        if first == 224 { low = 160 }
        if first == 237 { high = 159 };
    }
    if first >= 240 && first <= 244 {
        width = 4
        if first == 240 { low = 144 }
        if first == 244 { high = 143 };
    }
    if width == 0 { return -1 }
    let count = 1
    while count < width {
        if start + count >= source.len() { return -count }
        let next = uint(source[start + count])
        if count == 1 {
            if next < low || next > high { return -count };
        } else {
            if next < 128 || next > 191 { return -count };
        }
        count = count + 1
    }
    width
}

pub fn utf8_decode(source: Bytes) Result[string, EncodingError] {
    let index = 0
    while index < source.len() {
        let width = utf8_width(source.data, index)
        if width < 0 { return Err(EncodingError { offset: index }) }
        index = index + width
    }
    Ok(unsafe { std.runtime.string_from_utf8_unchecked(source.data) })
}

pub fn utf8_decode_lossy(source: Bytes) string {
    let length = 0
    let index = 0
    let valid = true
    while index < source.len() {
        let width = utf8_width(source.data, index)
        if width < 0 {
            valid = false
            length = length + 3
            index = index - width
        } else {
            length = length + width
            index = index + width
        }
    }
    if valid { return unsafe { std.runtime.string_from_utf8_unchecked(source.data) } }
    let data = unsafe { alloc_bytes(length) }
    index = 0
    let out = 0
    while index < source.len() {
        let width = utf8_width(source.data, index)
        if width < 0 {
            data[out] = 239
            data[out + 1] = 191
            data[out + 2] = 189
            out = out + 3
            index = index - width
        } else {
            for part in 0..width { data[out + part] = source.data[index + part] }
            out = out + width
            index = index + width
        }
    }
    unsafe { std.runtime.string_from_utf8_unchecked(data) }
}
