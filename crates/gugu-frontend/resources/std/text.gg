use std.text.normalization_tables as tables
use std.text.unicode.{TextSegments, case_mapping, utf8_scalar_width, write_utf8_scalar}

pub struct UnicodeVersion { pub major: int, pub minor: int, pub patch: int }

pub fn unicode_version() UnicodeVersion = UnicodeVersion { major: 17, minor: 0, patch: 0 }

// 只读快照持有受管切片；切片的 interior root 保持整个 backing 可达。
pub struct Bytes {
    data: &[byte],
}

// 不可变块链让追加为 O(1)，复制缓冲只共享已封存节点；freeze 线性物化一次。
struct BufferChunk {
    previous: Option[&BufferChunk],
    data: Bytes,
}

pub struct ByteBuffer {
    head: Option[&BufferChunk],
    length: int,
}

impl ByteBuffer {
    pub fn new() ByteBuffer = ByteBuffer { head: None, length: 0 }
    pub fn len(self: &Self) int = self.length
    pub fn freeze(self: &Self) Bytes {
        let data = unsafe { alloc_bytes(self.length) }
        let end = self.length
        let cursor = self.head
        while let Some(chunk) = cursor {
            end = end - chunk.data.len()
            _ = chunk.data.copy_to(data[end..])
            cursor = chunk.previous
        }
        unsafe { Bytes::from_owned(data) }
    }
    pub fn append(self: &Self, source: Bytes) {
        if source.len() == 0 { return }
        if source.len() > 9223372036854775807 - self.length { panic("byte buffer overflow") }
        let chunk = BufferChunk { previous: self.head, data: source }
        self.head = Some(&chunk)
        self.length = self.length + source.len()
    }
}

#[used]
pub fn concat(left: &[byte], right: &[byte]) string {
    let data = unsafe { alloc_bytes(left.len() + right.len()) }
    for index in 0..left.len() { data[index] = left[index] }
    for index in 0..right.len() { data[left.len() + index] = right[index] }
    unsafe { std.runtime.string_from_utf8_unchecked(data) }
}

// UTF-8 切片边界检查：位置 i 是标量边界当且仅当 i == 0、i == len，
// 或 data[i] 不是续字节（0b10xxxxxx）。返回值是 I8 车道 bool。
#[used]
pub fn utf8_boundary(data: &[byte], start: int, end: int) bool {
    if start < 0 || end < 0 || start > end || end > data.len() { return false }
    if start > 0 && start < data.len() && data[start] & 192 == 128 { return false }
    if end < data.len() && data[end] & 192 == 128 { return false }
    true
}

#[used]
pub fn string_compare(left: &[byte], right: &[byte]) int {
    let length = if left.len() < right.len() { left.len() } else { right.len() }
    for index in 0..length {
        if left[index] < right[index] { return -1 }
        if left[index] > right[index] { return 1 };
    }
    if left.len() < right.len() { return -1 }
    if left.len() > right.len() { return 1 }
    0
}

fn share_bytes() {
    let value = Bytes::new()
    let copy = value
    _ = value
    _ = copy
}

pub struct EncodingError {
    pub offset: int,
}

impl Error for EncodingError {
    fn message(self: &Self) string = "invalid unicode"
    fn source(self: &Self) Option[&dyn Error] = None
}

impl Print for EncodingError {
    fn print(self: &Self, out: &Formatter) {}
}

impl Debug for EncodingError {
    fn debug(self: &Self, out: &Formatter) {}
}

// 标准库内部写入新 backing 的唯一入口；返回值由现有 GC 分配管线管理。
pub unsafe fn alloc_bytes(length: int) &[byte] {
    if length < 0 { panic("negative byte length") }
    unsafe { std.runtime.alloc_bytes(uint(length)) }
}

impl Bytes {
    pub fn new() Bytes {
        let empty: [byte; 0] = []
        Bytes { data: &empty }
    }

    pub fn copy_from(source: &[byte]) Bytes {
        let data = unsafe { alloc_bytes(source.len()) }
        for index in 0..source.len() { data[index] = source[index] }
        Bytes { data: data }
    }

    pub fn from_string(value: string) Bytes {
        Bytes { data: unsafe { std.runtime.string_bytes(value) } }
    }

    // 调用者必须交出全部可写别名；之后只能通过只读 Bytes 观察该区间。
    pub unsafe fn from_owned(data: &[byte]) Bytes = Bytes { data: data }

    // 仅供标准库 native bridge 读取；调用者不得写入或跨 safepoint 保存裸地址。
    pub unsafe fn as_slice(self: &Self) &[byte] = self.data

    pub fn len(self: &Self) int = self.data.len()
    pub fn is_empty(self: &Self) bool = self.data.len() == 0

    pub fn get(self: &Self, index: int) Option[byte] {
        if index < 0 { panic("negative byte index") }
        if index >= self.data.len() { None } else { Some(self.data[index]) }
    }

    pub fn split_at(self: &Self, index: int) (Bytes, Bytes) {
        if index < 0 || index > self.data.len() { panic("byte split out of range") }
        (Bytes { data: self.data[..index] }, Bytes { data: self.data[index..] })
    }

    pub fn starts_with(self: &Self, prefix: Bytes) bool {
        if prefix.len() > self.len() { return false }
        for index in 0..prefix.len() {
            if self.data[index] != prefix.data[index] { return false };
        }
        true
    }

    pub fn ends_with(self: &Self, suffix: Bytes) bool {
        if suffix.len() > self.len() { return false }
        let start = self.len() - suffix.len()
        for index in 0..suffix.len() {
            if self.data[start + index] != suffix.data[index] { return false };
        }
        true
    }

    pub fn copy_to(self: &Self, destination: &[byte]) int {
        let count = self.len()
        if destination.len() < count { count = destination.len() }
        for index in 0..count { destination[index] = self.data[index] }
        count
    }

    pub fn to_string(self: &Self) Result[string, EncodingError] = utf8_decode(*self)
    pub fn to_string_lossy(self: &Self) string = utf8_decode_lossy(*self)
}

// 合法标量返回正长度；非法序列返回 maximal subpart 的负长度。
fn utf8_width(source: &[byte], start: int) int {
    let first = uint(source[start])
    if first < 128 { return 1 }
    let width = 0
    let low = uint(128)
    let high = uint(191)
    if first >= 194 && first <= 223 { width = 2 }
    if first >= 224 && first <= 239 {
        width = 3
        if first == 224 { low = 160 }
        if first == 237 { high = 159 };
    }
    if first >= 240 && first <= 244 {
        width = 4
        if first == 240 { low = 144 }
        if first == 244 { high = 143 };
    }
    if width == 0 { return -1 }
    let count = 1
    while count < width {
        if start + count >= source.len() { return -count }
        let next = uint(source[start + count])
        if count == 1 {
            if next < low || next > high { return -count };
        } else {
            if next < 128 || next > 191 { return -count };
        }
        count = count + 1
    }
    width
}

pub fn utf8_decode(source: Bytes) Result[string, EncodingError] {
    let index = 0
    while index < source.len() {
        let width = utf8_width(source.data, index)
        if width < 0 { return Err(EncodingError { offset: index }) }
        index = index + width
    }
    Ok(unsafe { std.runtime.string_from_utf8_unchecked(source.data) })
}

pub fn utf8_decode_lossy(source: Bytes) string {
    let length = 0
    let index = 0
    let valid = true
    while index < source.len() {
        let width = utf8_width(source.data, index)
        if width < 0 {
            valid = false
            length = length + 3
            index = index - width
        } else {
            length = length + width
            index = index + width
        }
    }
    if valid { return unsafe { std.runtime.string_from_utf8_unchecked(source.data) } }
    let data = unsafe { alloc_bytes(length) }
    index = 0
    let out = 0
    while index < source.len() {
        let width = utf8_width(source.data, index)
        if width < 0 {
            data[out] = 239
            data[out + 1] = 191
            data[out + 2] = 189
            out = out + 3
            index = index - width
        } else {
            for part in 0..width { data[out + part] = source.data[index + part] }
            out = out + width
            index = index + width
        }
    }
    unsafe { std.runtime.string_from_utf8_unchecked(data) }
}

pub enum NormalizationForm { NFC, NFD, NFKC, NFKD }

// string 的固有方法。修改方法把新值写回接收者；COW 分离由 `+` 与切片负责。
impl string {
    pub fn new() string = ""

    pub fn with_capacity(capacity: int) string {
        if capacity < 0 { panic("string capacity must not be negative") }
        ""
    }

    pub fn len(self: &Self) int = string_data(*self).len()
    pub fn cap(self: &Self) int = string_data(*self).len()
    pub fn is_empty(self: &Self) bool = string_data(*self).len() == 0
    pub fn clear(self: &Self) { *self = "" }

    pub fn reserve(self: &Self, additional: int) {
        if additional < 0 { panic("string reserve must not be negative") }
    }

    pub fn shrink_to_fit(self: &Self) {}
    pub fn push(self: &Self, value: char) { *self = *self + encode_char(value) }
    pub fn push_string(self: &Self, value: string) { *self = *self + value }

    pub fn insert(self: &Self, byte_offset: int, value: char) {
        let text = *self
        *self = text[..byte_offset] + encode_char(value) + text[byte_offset..]
    }

    pub fn remove(self: &Self, byte_offset: int) char {
        let text = *self
        let data = string_data(text)
        if byte_offset < 0 || byte_offset >= data.len() { panic("string remove offset out of range") }
        let width = utf8_width(data, byte_offset)
        *self = text[..byte_offset] + text[byte_offset + width..]
        decode_char(data, byte_offset, width)
    }

    pub fn truncate(self: &Self, byte_len: int) {
        let text = *self
        *self = text[..byte_len]
    }

    pub fn replace_range(self: &Self, range: Range, value: string) {
        let text = *self
        let head = text[..range.start]
        let tail = text[range.end..]
        if range.start > range.end { panic("string range start is after its end") }
        *self = head + value + tail
    }

    pub fn byte_at(self: &Self, byte_offset: int) Option[byte] {
        let data = string_data(*self)
        if byte_offset < 0 { panic("string byte offset must not be negative") }
        if byte_offset >= data.len() { return None }
        Some(data[byte_offset])
    }

    pub fn char_at(self: &Self, scalar_index: int) Option[char] {
        if scalar_index < 0 { panic("string scalar index must not be negative") }
        let chars = self.chars()
        let index = 0
        while let Some(value) = chars.next() {
            if index == scalar_index { return Some(value) }
            index = index + 1
        }
        None
    }

    pub fn chars(self: &Self) Chars = Chars { data: string_data(*self), offset: 0 }
    pub fn bytes_view(self: &Self) Bytes = Bytes::from_string(*self)
    pub fn normalize(self: &Self, form: NormalizationForm) string = normalize_text(*self, form)
    pub fn to_lowercase(self: &Self) string = case_mapping(*self, 0)
    pub fn to_uppercase(self: &Self) string = case_mapping(*self, 1)
    pub fn case_fold(self: &Self) string = case_mapping(*self, 2)
    pub fn graphemes(self: &Self) TextSegments = TextSegments::new(*self, 0)
    pub fn words(self: &Self) TextSegments = TextSegments::new(*self, 1)
    pub fn lines(self: &Self) TextSegments = TextSegments::new(*self, 2)
}

// 迭代创建时的 string 快照，逐个产生 Unicode scalar。
pub struct Chars {
    data: &[byte],
    offset: int,
}

impl Iter for Chars {
    type Item = char
    fn next(self: &Self) Option[char] {
        if self.offset >= self.data.len() { return None }
        let width = utf8_width(self.data, self.offset)
        let value = decode_char(self.data, self.offset, width)
        self.offset = self.offset + width
        Some(value)
    }
}

impl IntoIter for Chars {
    type Item = char
    type Iter = Chars
    fn into_iter(self: Self) Chars = self
}

fn string_data(value: string) &[byte] = unsafe { std.runtime.string_bytes(value) }

fn decode_char(data: &[byte], start: int, width: int) char {
    if width == 1 { return char(uint(data[start])) }
    let mask = if width == 2 { uint(31) } else if width == 3 { uint(15) } else { uint(7) }
    let code = uint(data[start]) & mask
    for index in 1..width { code = (code << 6) | (uint(data[start + index]) & 63) }
    char(code)
}

pub fn encode_char(value: char) string {
    let code = uint(value)
    let length = utf8_scalar_width(code)
    let data = unsafe { alloc_bytes(length) }
    write_utf8_scalar(data, 0, code, length)
    unsafe { std.runtime.string_from_utf8_unchecked(data) }
}

const HANGUL_BASE: uint = 0xAC00
const L_BASE: uint = 0x1100
const V_BASE: uint = 0x1161
const T_BASE: uint = 0x11A7
const L_COUNT: uint = 19
const V_COUNT: uint = 21
const T_COUNT: uint = 28
const LV_STRIDE: uint = V_COUNT * T_COUNT
const HANGUL_COUNT: uint = L_COUNT * LV_STRIDE

fn normalize_text(text: string, form: NormalizationForm) string {
    if is_ascii(text) { return text }

    let (compatible, compose) = match form {
        NormalizationForm::NFC => (false, true),
        NormalizationForm::NFD => (false, false),
        NormalizationForm::NFKC => (true, true),
        NormalizationForm::NFKD => (true, false),
    }
    let capacity = if text.len() < 16 { 16 } else { text.len() }
    let buffer = ScalarBuffer { data: unsafe { alloc_bytes(capacity) }, length: 0 }
    decompose_text(&buffer, text, compatible)
    reorder(&buffer)
    if compose { recompose(&buffer) }
    encode(&buffer)
}

fn is_ascii(text: string) bool {
    let bytes = string_data(text)
    for index in 0..bytes.len() {
        if bytes[index] >= 128 { return false }
    }
    true
}

// 托管 scratch：每个槽保存 24-bit scalar 和一个 combining class。
struct ScalarBuffer { data: &[byte], length: int }

impl ScalarBuffer {
    fn scalar(self: &Self, index: int) uint = read24(self.data, index * 4)
    fn class(self: &Self, index: int) byte = self.data[index * 4 + 3]
    fn put(self: &Self, index: int, scalar: uint, class: byte) {
        let at = index * 4
        self.data[at] = byte(scalar & 255)
        self.data[at + 1] = byte((scalar >> 8) & 255)
        self.data[at + 2] = byte(scalar >> 16)
        self.data[at + 3] = class
    }
    fn reserve(self: &Self, additional: int) {
        let capacity = self.data.len()
        if additional > capacity / 4 - self.length {
            if self.data.len() > 9223372036854775807 / 2 { panic("normalization size overflow") }
            let needed = (self.length + additional) * 4
            let size = if needed > capacity * 2 { needed } else { capacity * 2 }
            let next = unsafe { alloc_bytes(size) }
            for index in 0..(self.length * 4) { next[index] = self.data[index] }
            self.data = next
        }
    }
    fn push(self: &Self, scalar: uint, class: byte) {
        self.put(self.length, scalar, class)
        self.length = self.length + 1
    }
}

fn read24(data: &[byte], at: int) uint =
    uint(data[at]) | (uint(data[at + 1]) << 8) | (uint(data[at + 2]) << 16)

fn read_table_scalar(data: &[byte], at: int) uint =
    uint(data[at]) | (uint(data[at + 1]) << 7) | (uint(data[at + 2]) << 14)

fn find_scalar(table: &[byte], width: int, scalar: uint) int {
    let lo = 0
    let hi = table.len() / width
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        let at = mid * width
        let key = read_table_scalar(table, at)
        if key == scalar { return at }
        if key < scalar { lo = mid + 1 } else { hi = mid };
    }
    -1
}

fn combining_class(classes: &[byte], scalar: uint) byte {
    if scalar < 128 { return 0 }
    let at = find_scalar(classes, 5, scalar)
    if at < 0 { 0 } else { classes[at + 3] | (classes[at + 4] << 7) }
}

fn decompose_text(buffer: &ScalarBuffer, text: string, compatible: bool) {
    let chars = Chars { data: string_data(text), offset: 0 }
    while let Some(scalar) = chars.next() { decompose(buffer, uint(scalar), compatible) }
}

fn decompose(buffer: &ScalarBuffer, scalar: uint, compatible: bool) {
    if scalar < 128 {
        buffer.reserve(1)
        buffer.push(scalar, 0)
        return
    }
    if scalar >= HANGUL_BASE && scalar < HANGUL_BASE + HANGUL_COUNT {
        let s = scalar - HANGUL_BASE
        let t = s % T_COUNT
        buffer.reserve(if t == 0 { 2 } else { 3 })
        buffer.push(L_BASE + s / LV_STRIDE, 0)
        buffer.push(V_BASE + (s % LV_STRIDE) / T_COUNT, 0)
        if t != 0 { buffer.push(T_BASE + t, 0) }
        return
    }
    let (start, count) = decomposition(scalar, compatible)
    buffer.reserve(count)
    let classes = string_data(tables.combining_classes())
    if start < 0 {
        buffer.push(scalar, combining_class(classes, scalar))
        return
    }
    let payload = string_data(tables.decomposed_scalars())
    for part in start..(start + count) {
        let value = read_table_scalar(payload, part * 3)
        buffer.push(value, combining_class(classes, value))
    }
}

fn decomposition(scalar: uint, compatible: bool) (int, int) {
    let index = string_data(
        if compatible { tables.compatibility_index() } else { tables.canonical_index() }
    )
    let at = find_scalar(index, 7, scalar)
    if at < 0 { (-1, 1) } else {
        (int(read_table_scalar(index, at + 3)), int(index[at + 6]))
    }
}

fn reorder(buffer: &ScalarBuffer) {
    let start = 0
    while start < buffer.length {
        if buffer.class(start) == 0 {
            start = start + 1
        } else {
            let end = start + 1
            let ordered = true
            while end < buffer.length && buffer.class(end) != 0 {
                if buffer.class(end - 1) > buffer.class(end) { ordered = false }
                end = end + 1
            }
            if !ordered { reorder_marks(buffer, start, end) }
            start = end
        };
    }
}

// 稳定归并排序：同类标量保留顺序，长 combining run 也不会退化成平方复杂度。
fn reorder_marks(buffer: &ScalarBuffer, start: int, end: int) {
    let count = end - start
    let original = buffer.data[(start * 4)..(end * 4)]
    let source = original
    let destination = unsafe { alloc_bytes(count * 4) }
    let in_place = true
    let width = 1
    while width < count {
        let first = 0
        while first < count {
            let mid = min_index(first + width, count)
            let last = min_index(mid + width, count)
            merge_marks(source, destination, first, mid, last)
            first = last
        }
        let previous = source
        source = destination
        destination = previous
        in_place = !in_place
        width = width * 2
    }
    if !in_place {
        for i in 0..source.len() { original[i] = source[i] }
    }
}

fn min_index(left: int, right: int) int = if left < right { left } else { right }

fn merge_marks(source: &[byte], destination: &[byte], first: int, mid: int, last: int) {
    let left = first
    let right = mid
    for i in first..last {
        let at = if right == last || (left < mid && source[left * 4 + 3] <= source[right * 4 + 3]) {
            let at = left
            left = left + 1
            at
        } else {
            let at = right
            right = right + 1
            at
        }
        for lane in 0..4 { destination[i * 4 + lane] = source[at * 4 + lane] }
    }
}

fn compose_pair(pairs: &[byte], left: uint, right: uint) uint {
    if left >= L_BASE && left < L_BASE + L_COUNT && right >= V_BASE && right < V_BASE + V_COUNT {
        return HANGUL_BASE + (left - L_BASE) * LV_STRIDE + (right - V_BASE) * T_COUNT
    }
    if left >= HANGUL_BASE && left < HANGUL_BASE + HANGUL_COUNT &&
        (left - HANGUL_BASE) % T_COUNT == 0 && right > T_BASE && right < T_BASE + T_COUNT {
        return left + right - T_BASE
    }
    if right < 128 { return 0 }
    let lo = 0
    let hi = pairs.len() / 9
    let key = (left << 21) | right
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        let at = mid * 9
        let found = (read_table_scalar(pairs, at) << 21) | read_table_scalar(pairs, at + 3)
        if found == key { return read_table_scalar(pairs, at + 6) }
        if found < key { lo = mid + 1 } else { hi = mid };
    }
    0
}

fn recompose(buffer: &ScalarBuffer) {
    let pairs = string_data(tables.composition_pairs())
    let count = 0
    let starter = -1
    let previous: byte = 0
    for index in 0..buffer.length {
        let scalar = buffer.scalar(index)
        let class = buffer.class(index)
        let combined = if starter >= 0 && (previous == 0 || previous < class) {
            compose_pair(pairs, buffer.scalar(starter), scalar)
        } else { uint(0) }
        if combined != 0 {
            buffer.put(starter, combined, 0)
        } else {
            if class == 0 { starter = count }
            buffer.put(count, scalar, class)
            count = count + 1
            previous = class
        };
    }
    buffer.length = count
}

fn encode(buffer: &ScalarBuffer) string {
    let length = 0
    for i in 0..buffer.length { length = length + utf8_scalar_width(buffer.scalar(i)) }
    let data = unsafe { alloc_bytes(length) }
    let at = 0
    for i in 0..buffer.length {
        let code = buffer.scalar(i)
        let width = utf8_scalar_width(code)
        write_utf8_scalar(data, at, code, width)
        at = at + width
    }
    unsafe { std.runtime.string_from_utf8_unchecked(data) }
}
