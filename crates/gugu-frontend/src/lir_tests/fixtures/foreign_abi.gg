#[repr(C)] struct Floats { a: f64, b: f64 }
#[repr(C)] struct Mixed { a: uint, b: f64 }
#[repr(C)] struct Large { a: uint, b: uint, c: uint }
#[repr(C)] struct Small { a: f32 }
#[repr(transparent)] struct Transparent { a: f32 }
#[ffi(leaf, stack = 128)] unsafe extern "C" fn floats(value: Floats) Floats
#[ffi(leaf, stack = 128)] unsafe extern "C" fn mixed(a: uint, b: uint, c: uint, d: uint, e: uint, f: uint, value: Mixed, last: f64) Mixed
#[ffi(leaf, stack = 128)] unsafe extern "C" fn large(value: Large) Large
#[ffi(leaf, stack = 128)] unsafe extern "C" fn small(value: Small) Small
#[ffi(leaf, stack = 128)] unsafe extern "C" fn transparent(value: Transparent) Transparent
fn main() { unsafe {
    let _ = floats(Floats { a: 1.0, b: 2.0 })
    let _ = mixed(1, 2, 3, 4, 5, 6, Mixed { a: 7, b: 8.0 }, 9.0)
    let _ = large(Large { a: 1, b: 2, c: 3 })
    let _ = small(Small { a: 1.0 })
    let _ = transparent(Transparent { a: 2.0 })
} }
