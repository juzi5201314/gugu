use std.io.{println}

struct Number { value: int }
impl Add[Number] for Number {
    type Output = int
    fn add(self, rhs: Number) int = self.value + rhs.value
}

fn next(value: &int) int {
    *value += 1
    *value
}

fn main() {
    let x = 5
    let count = 0
    let left = Number { value: 3 }
    let right = Number { value: 4 }
    println(f"{1 + 2}|{(1 + 2)}|{x * 2}|{x > 0}|{x > 0 && x < 10}|{1 + 2:04x}|{"a" + "b"}|{next(&count) + next(&count)}|{count}|{left + right}|{left + right + 2:?}")
}
