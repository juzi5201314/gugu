use std.collections.{LinkedList, HashMap, Vec}

fn read[T](value: &T) T = *value
fn recursive_read(value: &int, depth: int) int {
    if depth == 0 { *value } else { recursive_read(value, depth - 1) }
}
fn reads() int {
    let list = LinkedList[int]::new()
    _ = list.push_back(3)
    _ = list.push_back(4)
    let sum = 0
    list.for_each_ref(fn(value: &int) {
        let local = Some(value)
        if let Some(alias) = local { sum += recursive_read(alias, 2) }
    })
    if sum != 7 { panic("读取和同步 helper 应保留全部元素") }
    let map = HashMap[int, int]::new()
    _ = map.insert(1, 11)
    let key = 1
    match map.with_ref(&key, fn(value: &int) int = read(value)) {
        Some(value) => { if value != 11 { panic("值返回错误") } },
        None => panic("缺少键"),
    }
    let values = Vec[int]::new()
    values.push(13)
    let nested = LinkedList[Vec[int]]::new()
    _ = nested.push_back(values)
    let copied: Option[Vec[int]] = None
    nested.for_each_ref(fn(value: &Vec[int]) { copied = Some(*value) })
    match copied {
        Some(value) => { if value.get(0) != Some(13) { panic("身份值语义副本错误") } },
        None => panic("值副本不得被误判为 view 逃逸"),
    }
    1
}
fn main() { _ = reads() }
