use std.runtime.resource.{ResourceCell}

fn make(i: int, fail: bool) ResourceCell {
    if i == 2 && fail { panic("RHS") }
    ResourceCell { control: uint(1024 + i * 256) }
}

pub fn overwrite() {
    let a: [ResourceCell; 3]
    for i in 0..3 { a[i] = make(i, false) }
    a[1] = make(3, false)
}

pub fn partial() {
    let a: [ResourceCell; 4]
    for i in 0..4 { a[i] = make(i, true) }
}

pub fn empty() {
    let a: [ResourceCell; 0]
    for i in 0..0 { a[i] = make(i, true) }
}
