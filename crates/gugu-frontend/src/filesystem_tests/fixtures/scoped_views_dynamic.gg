use std.collections.{LinkedList}

fn apply(callback: fn(&int), value: &int) { callback(value) }
fn main() {
    let list = LinkedList[int]::new()
    _ = list.push_back(7)
    let escaped: Option[&int] = None
    let callback: fn(&int) = fn(value: &int) { escaped = Some(value) }
    list.for_each_ref(fn(value: &int) { apply(callback, value) })
    _ = escaped
}
