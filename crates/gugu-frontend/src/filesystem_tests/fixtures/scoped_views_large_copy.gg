use std.collections.{HashMap}

struct Payload { words: [uint; 4] }

fn copy_large() int {
    let map = HashMap[int, Payload]::new()
    _ = map.insert(1, Payload { words: [3, 5, 7, 11] })
    let key = 1
    let copy: Payload = match map.with_ref(&key, fn(value: &Payload) Payload = *value) {
        Some(value) => value,
        None => panic("缺少大结构值"),
    }
    if copy.words[0] != 3 || copy.words[1] != 5 || copy.words[2] != 7 || copy.words[3] != 11 {
        panic("大结构返回值不完整")
    }
    copy.words[0] = 17
    match map.get(&key) {
        Some(value) => { if value.words[0] != 3 { panic("值副本修改影响了原值") } },
        None => panic("原值丢失"),
    }
    1
}

fn main() { _ = copy_large() }
